i = 0;\n  // length is in bytes; U16_NEXT indexes into uint16_t*, so its length\n  // parameter must be in code units (length / 2), not bytes.\n  U16_NEXT_BE(((uint16_t *)string), i, length / 2, *code_point);\n  return i * 2;\n}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif  // TREE_SITTER_UNICODE_H_\n"","
