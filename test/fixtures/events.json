{
  "description": "Event contract fixtures (EXECUTION_PLAN, Phase 1). Inventory extracted from emit() call sites in agent/ and web/; baseline sequence captured from a live stub run ending in a final answer.",
  "envelope": {
    "required_fields": ["seq", "type", "at", "run_id", "turn_id", "scope", "iteration"],
    "context_fields": ["run_id", "turn_id", "scope", "iteration"],
    "semantics": "setContext() patches only known context keys; an emit payload field overrides the matching context field for that event; seq increments monotonically per process",
    "additive": true
  },
  "inventory": [
    "agent:action",
    "agent:end",
    "agent:iteration",
    "agent:response",
    "agent:start",
    "agent:thinking",
    "approval:request",
    "approval:resolved",
    "context:compacted",
    "context:memory",
    "delegation:end",
    "delegation:graph",
    "delegation:start",
    "discussion:error",
    "discussion:finish",
    "discussion:message",
    "discussion:observer",
    "discussion:round",
    "discussion:start",
    "endpoint:degraded",
    "git:report",
    "hook:end",
    "hook:phase:end",
    "hook:phase:start",
    "hook:start",
    "mcp:added",
    "mcp:call",
    "mcp:connected",
    "mcp:disconnected",
    "mcp:install",
    "mcp:problem",
    "mcp:reconnected",
    "mcp:removed",
    "mcp:result",
    "mcp:unavailable",
    "plan:autoroute:end",
    "plan:autoroute:start",
    "policy:decision",
    "queue:changed",
    "registry:loaded",
    "report:mismatch",
    "request:end",
    "request:start",
    "response:repaired",
    "run:auto_continue",
    "run:auto_stopped",
    "run:continue",
    "run:correction",
    "run:deadline",
    "run:delegation_hint",
    "run:end",
    "run:error",
    "run:loop",
    "run:malformed",
    "run:nudge",
    "run:start",
    "run:status",
    "run:wrapup",
    "secret:changed",
    "session:approval_mode",
    "session:cleared",
    "session:message",
    "session:switched",
    "settings:changed",
    "skill:loaded",
    "skill:read",
    "tool:arguments_ignored",
    "tool:end",
    "tool:graph",
    "tool:start"
  ],
  "excluded_mechanic_names": ["event", "change", "entry", "cleared", "sink-error"],
  "baseline_final_turn_sequence": [
    "run:start",
    "agent:iteration",
    "request:start",
    "request:end",
    "agent:response",
    "agent:action",
    "run:nudge",
    "agent:iteration",
    "request:start",
    "request:end",
    "agent:response",
    "agent:action",
    "run:end"
  ],
  "key_payloads": {
    "run:start": ["run_id", "turn_id", "task"],
    "agent:iteration": ["iteration"],
    "tool:start": ["id", "name"],
    "tool:end": ["id", "name", "success"],
    "run:end": ["success"]
  }
}
