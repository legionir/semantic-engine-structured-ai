{
  "description": "Action contract fixtures captured from the live runtime (EXECUTION_PLAN, Phase 1). Every expectation below was generated by calling the real parser/validator; do not hand-edit without re-verifying against the code.",
  "envelope": {
    "top_level_keys": [
      "version",
      "tool_calls",
      "delegations",
      "response",
      "data",
      "error",
      "action",
      "performed"
    ],
    "version_value": "1.0",
    "provider_envelope": "parse entry points take the raw provider response: { choices: [ { message: { role, content } } ] }"
  },
  "required_fields": {
    "tool_call_item": ["id", "name", "arguments", "depends_on"],
    "delegation_item": ["id", "agent", "persona", "skills", "tools", "task", "depends_on"],
    "final_response": ["type", "content"]
  },
  "normalization_rules_observed": [
    "readModelAction injects depends_on: [] into tool calls that omit it",
    "a delegation to a REGISTERED agent must carry persona, skills and tools set to null (empty arrays are rejected)"
  ],
  "cases": [
    {
      "name": "tool_call",
      "input": {
        "version": "1.0",
        "tool_calls": [
          { "id": "call_1", "name": "fs_read", "arguments": { "path": "x.txt" } }
        ],
        "delegations": null,
        "response": null,
        "data": null,
        "error": null,
        "action": "tool_call",
        "performed": null
      },
      "expected": {
        "parse_source": "structured_content",
        "action": "tool_call",
        "tool_call_depends_on_injected": [],
        "validate": "OK"
      }
    },
    {
      "name": "delegate_registered_agent",
      "input": {
        "version": "1.0",
        "tool_calls": null,
        "delegations": [
          {
            "id": "a1",
            "agent": "code_analysis",
            "persona": null,
            "skills": null,
            "tools": null,
            "task": "Analyze X",
            "depends_on": []
          }
        ],
        "response": null,
        "data": null,
        "error": null,
        "action": "delegate",
        "performed": null
      },
      "expected": {
        "parse_source": "structured_content",
        "action": "delegate",
        "validate": "OK"
      }
    },
    {
      "name": "final",
      "input": {
        "version": "1.0",
        "tool_calls": null,
        "delegations": null,
        "response": { "type": "text", "content": "done" },
        "data": null,
        "error": null,
        "action": "final",
        "performed": null
      },
      "expected": {
        "parse_source": "structured_content",
        "action": "final",
        "validate": "OK"
      }
    }
  ],
  "error_cases": [
    {
      "name": "malformed_text",
      "input_content": "not json at all",
      "expected": {
        "read_model_action": "THROWS",
        "message_prefix": "AI returned neither structured JSON nor a native tool call.",
        "is_model_response_error": true
      }
    },
    {
      "name": "tool_call_missing_id",
      "input": {
        "version": "1.0",
        "tool_calls": [
          { "name": "fs_read", "arguments": { "path": "x.txt" } }
        ],
        "delegations": null,
        "response": null,
        "data": null,
        "error": null,
        "action": "tool_call",
        "performed": null
      },
      "expected": {
        "validate_action": "THROWS",
        "message_prefix": "Tool call is missing required field(s): id."
      }
    },
    {
      "name": "delegate_registered_agent_empty_arrays",
      "input": {
        "version": "1.0",
        "tool_calls": null,
        "delegations": [
          {
            "id": "a1",
            "agent": "code_analysis",
            "persona": [],
            "skills": [],
            "tools": [],
            "task": "Analyze X",
            "depends_on": []
          }
        ],
        "response": null,
        "data": null,
        "error": null,
        "action": "delegate",
        "performed": null
      },
      "expected": {
        "validate_throws_prefix": "A registered-agent delegation must set persona, skills and tools to null"
      },
      "note": "persona/skills/tools were verified to be rejected as empty arrays and accepted as null"
    }
  ]
}
