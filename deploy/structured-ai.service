# Structured AI console as a systemd service (roadmap P1-08).
#
#   sudo cp deploy/structured-ai.service /etc/systemd/system/
#   sudo cp deploy/structured-ai.env.example /etc/structured-ai.env   # then edit it
#   sudo chmod 600 /etc/structured-ai.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now structured-ai
#   journalctl -u structured-ai -f
#
# Paths assume the repository in /opt/structured-ai, a "structured-ai" system
# user whose home is /var/lib/structured-ai (npx, uvx and Playwright keep
# their caches there), and projects under /srv/projects:
#
#   sudo useradd --system --create-home --home-dir /var/lib/structured-ai \
#        --shell /usr/sbin/nologin structured-ai
#   sudo mkdir -p /srv/projects && sudo chown structured-ai: /srv/projects
#
# Change User, WorkingDirectory, ExecStart and ReadWritePaths together if
# yours differ.

[Unit]
Description=Structured AI agent console
Documentation=https://github.com/legionir/semantic-engine-structured-ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=structured-ai
Group=structured-ai
WorkingDirectory=/opt/structured-ai
EnvironmentFile=/etc/structured-ai.env
# Listens on localhost only: a reverse proxy (Caddy, nginx) terminates HTTPS.
ExecStart=/usr/bin/node bin/agent.js -s 7777 --host 127.0.0.1 -w /srv/projects
Restart=always
RestartSec=3
# Give a running turn time to save its checkpoint before the process is killed;
# an interrupted turn can be continued from the console after the restart.
TimeoutStopSec=20
KillMode=mixed

# Hardening that does not get in the way of git, npm or MCP servers.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/projects /var/lib/structured-ai
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
