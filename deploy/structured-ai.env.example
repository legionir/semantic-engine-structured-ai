# Environment for deploy/structured-ai.service. Keep it private:
#   sudo chmod 600 /etc/structured-ai.env
#
# Every setting of the console can be set here; see the settings table in
# README.md. These are the ones a server needs.

# The console token: the password of the web panel. 32+ random characters:
#   openssl rand -base64 32
AGENT_CONSOLE_TOKEN=change-me

# Where state, logs, the secret store and cloned projects live.
STRUCTURED_AI_DATA_HOME=/var/lib/structured-ai/data
PROJECTS_ROOT=/srv/projects

# The model endpoint (OpenAI-compatible). Providers can also be set in the
# console's LLM settings instead.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_MODEL=gpt-4.1

# Optional: a fixed key for the secret store instead of <data home>/secrets.key.
# SECRET_STORE_KEY=

# How many projects may run at once, and when to warn about memory and disk.
MAX_CONCURRENT_PROJECT_RUNS=4
RESOURCE_MIN_FREE_MEMORY_MB=200
RESOURCE_MIN_FREE_DISK_MB=1024

