+            this.lastError = null;
+
+            this.failedAt = 0;
+
+            this.trackGeneration(result);
+
+            if (cacheKey) {
+
+                const limit =
+                    settings.get("SEMANTIC_POOL_CACHE_LIMIT");
+
+                while (
+                    this.resultCache.size >= limit &&
+                    this.resultCache.size > 0
+                ) {
+
+                    const oldest =
+                        this.resultCache.keys().next().value;
+
+                    this.resultCache.delete(oldest);
+
+                }
+
+                if (limit > 0) {
+                    this.resultCache.set(cacheKey, result);
+                }
+
+            }
+
+            events.emit("mcp:result", {
+                server: this.serverName,
+                tool: method,
+                duration_ms: Date.now() - startedAt,
+                ok: true
+            });
+
+            return result;
+
+        } catch (error) {
+
+            this.lastError = error.message;
+
+            this.failedAt = Date.now();
+
+            events.emit("mcp:result", {
+                server: this.serverName,
+                tool: method,
+                duration_ms: Date.now() - startedAt,
+                ok: false,
+                error: error.message
+            });
+
+            throw error;
+
+        }
+
+    }
+
+
+    /* The staleness probe reads the index file under THIS project's
+       root; the heuristics are the legacy module's, only the root
+       differs. */
+    checkStaleness() {
+
+        return (
+            this.root
+                ? legacy.checkStaleness(this.root)
+                : legacy.checkStaleness()
+        );
+
+    }
+
+
+    startIndexSession(sessionId, sessionData) {
+
+        this.indexSessions.set(sessionId, sessionData);
+
+    }
+
+
+    getIndexSession(sessionId) {
+
+        return this.indexSessions.get(sessionId);
+
+    }
+
+
+    stopIndexSession(sessionId) {
+
+        this.indexSessions.delete(sessionId);
+
+    }
+
+
+    /* One project's outage must be observable without touching its
+       neighbours: the pool reports lifecycle state per client. */
+    health() {
+
+        return {
+            project_id: this.projectId,
+            endpoint: this.endpoint,
+            available: this.isAvailable(),
+            connected:
+                Boolean(this.client) && this.client.state === "ready",
+            degraded: this.lastError !== null,
+            last_error: this.lastError,
+            failed_at: this.failedAt || null,
+            index_generation: this.indexGeneration,
+            index_status: this.checkStaleness().state
+        };
+
+    }
+
+
+    diagnostics() {
+
+        return (
+            this.client
+                ? this.client.diagnosticsTail(50)
+                : []
+        );
+
+    }
+
+
+    async disconnect() {
+
+        if (!this.client) {
+            return;
+        }
+
+        const client = this.client;
+
+        this.client = null;
+
+        await client.close().catch(() => {});
+
+    }
+
+
+    /* Full reset: connection, definition and per-project caches. Index
+       sessions survive a reload (they represent work already handed to
+       the worker, like background processes survive run scopes). */
+    async reload(project) {
+
+        await this.disconnect();
+
+        this.cachedDefinition = null;
+
+        this.resultCache.clear();
+
+        if (project) {
+
+            this.root = canonicalRoot(project.workspaceRoot) || this.root;
+
+            this.endpoint =
+
+                (project.semanticEndpoint &&
+                    String(project.semanticEndpoint).trim()) || null;
+
+        }
+
+        this.indexGeneration = null;
+
+    }
+
+
+    async shutdown() {
+
+        await this.disconnect();
+
+        this.cachedDefinition = null;
+
+        this.resultCache.clear();
+
+    }
+
+
+}
+
+
+module.exports = SemanticClient;
diff --git a/structured-ai/agent/mcp/SemanticClientPool.js b/structured-ai/agent/mcp/SemanticClientPool.js
new file mode 100644
index 0000000..ac75c7f
--- /dev/null
+++ b/structured-ai/agent/mcp/SemanticClientPool.js
@@ -0,0 +1,198 @@
+const settings = require("../lib/storage");
+
+const SemanticClient = require("./SemanticClient");
+
+
+/*
+|--------------------------------------------------------------------------|
+| Semantic Client Pool                                                     |
+|--------------------------------------------------------------------------|
+|
+| Phase 6 of EXECUTION_PLAN (گام ۲): one SemanticClient per project, keyed
+| by projectId. Every project's worker connection lives and dies on its
+| own — connecting, disconnecting or reloading project A never disturbs
+| project B's client, and a degraded worker surfaces through that
+| project's client alone.
+|
+| The pool is consulted only in SEMANTIC_POOL_MODE=modular; in legacy
+| mode the resolver never reaches for it and the process keeps the
+| single historical client from mcp/semantic.js.
+|
+| Endpoints come from the project records in the registry
+| (ProjectRegistry record → ProjectContext.semanticEndpoint), so moving
+| from the test stub to the real Semantic Gateway is a data change —
+| PATCH the registry entry — not a code change (گام ۴ / acceptance).
+|
+|--------------------------------------------------------------------------
+*/
+
+
+class SemanticClientPool {
+
+    constructor() {
+
+        this.clients = new Map();
+
+    }
+
+
+    /* The client currently bound to this project, or null when none has
+       been connected yet. */
+    get(projectId) {
+
+        return this.clients.get(projectId) || null;
+
+    }
+
+
+    /* project-shaped object: { projectId, workspaceRoot, semanticEndpoint
+       } — the same fields a Phase-2 ProjectContext carries. Reconnecting
+       an already-connected project is free; a changed endpoint or root
+       rebuilds the client so stale connections never linger. */
+    connect(project) {
+
+        if (!project || !project.projectId) {
+
+            throw new Error(
+                "Semantic pool connect requires a project with a projectId."
+            );
+
+        }
+
+        const existing = this.clients.get(project.projectId);
+
+        if (existing) {
+
+            if (existing.matches(project)) {
+                return existing;
+            }
+
+            void existing.disconnect().catch(() => {});
+
+            this.clients.delete(project.projectId);
+
+        }
+
+        const client =
+
+            new SemanticClient({
+                projectId: project.projectId,
+                workspaceRoot: project.workspaceRoot,
+                semanticEndpoint: project.semanticEndpoint
+            });
+
+        this.clients.set(project.projectId, client);
+
+        return client;
+
+    }
+
+
+    async disconnect(projectId) {
+
+        const client = this.clients.get(projectId);
+
+        if (!client) {
+            return false;
+        }
+
+        this.clients.delete(projectId);
+
+        await client.shutdown();
+
+        return true;
+
+    }
+
+
+    /* Re-reads the registry record and rebuilds the client; this is the
+       one-call answer to "the gateway moved" — nothing in the client
+       code needs to change (endpoint swap is data). Without a registry
+       record the client is simply dropped. */
+    async reload(projectId) {
+
+        const { registry } = require("../projects");
+
+        await this.disconnect(projectId);
+
+        const record = registry().get(projectId);
+
+        if (!record) {
+            return null;
+        }
+
+        const { createProjectContext } = require("../projects");
+
+        return this.connect(createProjectContext(record));
+
+    }
+
+
+    async disconnectAll() {
+
+        const closing = [...this.clients.values()];
+
+        this.clients.clear();
+
+        await Promise.all(
+            closing.map(client => client.shutdown().catch(() => {}))
+        );
+
+    }
+
+
+    projectIds() {
+
+        return [...this.clients.keys()].sort();
+
+    }
+
+
+    /* Diagnostics for one project or the whole pool; additive surface
+       for the console and tests, never consumed by the legacy path. */
+    health(projectId) {
+
+        if (projectId !== undefined) {
+
+            const client = this.get(projectId);
+
+            return client ? client.health() : null;
+
+        }
+
+        return this.projectIds().map(
+            id => this.clients.get(id).health()
+        );
+
+    }
+
+
+}
+
+
+const pool = new SemanticClientPool();
+
+
+/* Keep the pool in step with the same settings that re-tune the legacy
+   client: a changed timeout/transport/disabled engine must not keep
+   serving through connections negotiated under old settings. */
+settings.bus.on("change", event => {
+
+    if (
+        event.key === "SEMANTIC_POOL_MODE" ||
+        event.key === "SEMANTIC_TRANSPORT" ||
+        event.key === "SEMANTIC_CALL_TIMEOUT_MS" ||
+        event.key === "SEMANTIC_ENABLED"
+    ) {
+
+        void pool.disconnectAll();
+
+    }
+
+});
+
+
+module.exports = {
+    SemanticClientPool,
+    pool
+};
diff --git a/structured-ai/agent/projects/ProjectContext.js b/structured-ai/agent/projects/ProjectContext.js
new file mode 100644
index 0000000..fb00018
--- /dev/null
+++ b/structured-ai/agent/projects/ProjectContext.js
@@ -0,0 +1,65 @@
+"use strict";
+
+const path = require("path");
+
+const ProjectStore = require("./ProjectStore");
+
+/*
+|--------------------------------------------------------------------------
+| Project Context
+|--------------------------------------------------------------------------
+|
+| The explicit per-project context every runtime operation receives
+| (EXECUTION_PLAN, Phase 2). It is built from a registry record and is the
+| ONLY shape downstream code may use — it never exposes the raw, possibly
+| uncanonicalized root a caller typed.
+|
+| dataRoot layout:
+|   registered project   -> <dataHome>/projects/<id>   (central store)
+|   synthetic default    -> <workspaceRoot>/.agent     (legacy layout kept
+|      (from -w/WORKSPACE_ROOT)                          until the Phase-8
+|                                                          migration)
+|
+| The legacy mapping is what lets the CLI keep working byte-for-byte while
+| the multi-project machinery lands in phases 3–8.
+|
+*/
+
+function createProjectContext(project, { syntheticDefault = false } = {}) {
+
+    if (!project || typeof project !== "object") {
+
+        throw new Error(
+            "Cannot build a project context without a project record."
+        );
+
+    }
+
+    const synthetic =
+        syntheticDefault || project.synthetic === true;
+
+    const dataRoot =
+        synthetic
+            ? path.join(project.rootPath, ".agent")
+            : path.join(
+                  ProjectStore.resolveDataHome(),
+                  "projects",
+                  project.id
+              );
+
+    return {
+        projectId: project.id,
+        projectName: project.name,
+        workspaceRoot: project.rootPath,
+        dataRoot,
+        semanticEndpoint: project.semanticEndpoint ?? null,
+        permissions: { ...(project.permissions || {}) },
+        synthetic
+    };
+
+}
+
+
+module.exports = {
+    createProjectContext
+};
diff --git a/structured-ai/agent/projects/ProjectMigration.js b/structured-ai/agent/projects/ProjectMigration.js
new file mode 100644
index 0000000..bc73922
--- /dev/null
+++ b/structured-ai/agent/projects/ProjectMigration.js
@@ -0,0 +1,242 @@
+"use strict";
+
+/*
+|--------------------------------------------------------------------------
+| Legacy State Migration — EXECUTION_PLAN, Phase 8 گام ۳
+|--------------------------------------------------------------------------
+|
+| Single-project era state lives under `<workspace>/.agent/`; registered
+| projects keep it centrally under `<dataHome>/projects/<id>/`. This
+| module copies the legacy state forward:
+|
+|   .agent/memory.json     -> projects/<id>/memory.json
+|   .agent/plan.json       -> projects/<id>/plan.json
+|   .agent/project.json    -> projects/<id>/project.json
+|   .agent/sessions/       -> projects/<id>/sessions/
+|   .agent/archive/        -> projects/<id>/archive/
+|   .agent/journal/        -> projects/<id>/journal/
+|   .agent/eventstore/     -> projects/<id>/eventstore/
+|   .agent/searches/       -> projects/<id>/searches/
+|   .agent/processes/      -> projects/<id>/processes/
+|   .agent/logs/           -> projects/<id>/logs/
+|
+| Properties the phase demands:
+|
+|   idempotent   a copy only ever fills a gap: a file that already
+|                exists at the target is reported as skipped, never
+|                overwritten, so re-running migration neither
+|                duplicates nor corrupts newer central state
+|
+|   non-destructive
+|                the legacy files are NEVER deleted (they remain the
+|                compatibility layer legacy mode still reads)
+|
+|   resilient    one unreadable or corrupt file is one error entry in
+|                the report, not a stopped migration
+|
+| The legacy source root comes from the REGISTRY record's rootPath —
+| never from CLI/model arguments (rule 9); --migrate without -w only
+| ever touches roots the operator previously registered.
+|
+|--------------------------------------------------------------------------
+*/
+
+const fs = require("fs");
+const path = require("path");
+
+const dataRoot = require("../lib/dataRoot");
+
+
+const FILES = [
+    "memory.json",
+    "plan.json",
+    "project.json"
+];
+
+const DIRECTORIES = [
+    "sessions",
+    "archive",
+    "journal",
+    "eventstore",
+    "searches",
+    "processes",
+    "logs"
+];
+
+
+/* Every regular file under `dir`, relative to it (recursive). */
+function walkFiles(dir) {
+
+    const found = [];
+
+    if (!fs.existsSync(dir)) {
+        return found;
+    }
+
+    const stack = [""];
+
+    while (stack.length > 0) {
+
+        const relative = stack.pop();
+        const absolute = path.join(dir, relative);
+
+        let entries;
+
+        try {
+
+            entries = fs.readdirSync(absolute, { withFileTypes: true });
+
+        } catch {
+
+            continue;
+        }
+
+        for (const entry of entries) {
+
+            const child = path.join(relative, entry.name);
+
+            if (entry.isDirectory()) {
+
+                stack.push(child);
+
+            } else if (entry.isFile()) {
+
+                found.push(child);
+
+            }
+
+        }
+    }
+
+    return found.sort();
+}
+
+
+/* Copy-missing-only: fills the target file iff it does not exist. The
+   result distinguishes copy/skip/error so the report is honest about
+   what a rerun changed (nothing). */
+function copyMissing(source, target) {
+
+    try {
+
+        if (fs.existsSync(target)) {
+            return "skipped";
+        }
+
+        fs.mkdirSync(path.dirname(target), { recursive: true });
+        fs.copyFileSync(source, target);
+
+        return "copied";
+
+    } catch (error) {
+
+        return error.message;
+
+    }
+}
+
+
+/*
+| Migrates the legacy `.agent` state of `record` (a registry record
+| shape: { id, rootPath }) into its central data root. Returns the
+| report — it never throws: a broken legacy tree is data for the
+| report, not a reason to kill the process.
+*/
+function migrateProject(record) {
+
+    if (
+        !record ||
+        typeof record.id !== "string" ||
+        typeof record.rootPath !== "string"
+    ) {
+
+        throw new Error(
+            "migrateProject needs a registry record ({ id, rootPath })."
+        );
+
+    }
+
+    const { createProjectContext } = require("./ProjectContext");
+
+    const source =
+        path.join(record.rootPath, ".agent");
+
+    const target =
+        createProjectContext(record).dataRoot;
+
+    const report = {
+        project_id: record.id,
+        source,
+        target,
+        source_present: fs.existsSync(source),
+        copied: [],
+        skipped: [],
+        errors: []
+    };
+
+    /* The full central layout exists afterwards whether or not the
+       legacy side had anything to give (گام ۱ scaffold). */
+    try {
+
+        dataRoot.ensureRoot(target);
+
+    } catch (error) {
+
+        report.errors.push({
+            file: null,
+            error: error.message
+        });
+
+        return report;
+    }
+
+    if (!report.source_present) {
+        return report;
+    }
+
+    /* A file the legacy side never had is not a candidate (absence is
+       not corruption — there is just nothing to move). */
+    const candidates = [
+        ...FILES.filter(
+            name => fs.existsSync(path.join(source, name))
+        ),
+        ...DIRECTORIES.flatMap(
+            dir => walkFiles(path.join(source, dir))
+                .map(relative => path.join(dir, relative))
+        )
+    ];
+
+    for (const relative of candidates) {
+
+        const outcome = copyMissing(
+            path.join(source, relative),
+            path.join(target, relative)
+        );
+
+        if (outcome === "copied") {
+
+            report.copied.push(relative);
+
+        } else if (outcome === "skipped") {
+
+            report.skipped.push(relative);
+
+        } else {
+
+            report.errors.push({
+                file: relative,
+                error: outcome
+            });
+
+        }
+    }
+
+    return report;
+}
+
+
+module.exports = {
+    FILES,
+    DIRECTORIES,
+    migrateProject
+};
diff --git a/structured-ai/agent/projects/ProjectRegistry.js b/structured-ai/agent/projects/ProjectRegistry.js
new file mode 100644
index 0000000..eb377d2
--- /dev/null
+++ b/structured-ai/agent/projects/ProjectRegistry.js
@@ -0,0 +1,376 @@
+"use strict";
+
+const crypto = require("crypto");
+const fs = require("fs");
+const path = require("path");
+
+const ProjectStore = require("./ProjectStore");
+
+/*
+|--------------------------------------------------------------------------
+| Project Registry
+|--------------------------------------------------------------------------
+|
+| Registers and resolves the projects Structured AI knows about. Rules
+| (EXECUTION_PLAN, Phase 2):
+|
+|   - roots are canonicalized with realpath before they identify anything
+|   - registering an already-known root returns the existing project,
+|     never a duplicate
+|   - a project id is NOT derived from the raw root string; it is slug of
+|     the display name plus a short hash of the CANONICAL root, fixed at
+|     registration time — so renaming the project never changes its id
+|   - a root path may therefore be read only through the registry
+|
+| Ids look like:  prj-engine-core-3fa9c1d2
+|
+*/
+
+const DEFAULT_PERMISSIONS = Object.freeze({
+    read: true,
+    write: true,
+    terminal: true,
+    git: true
+});
+
+
+function slugify(name) {
+
+    const slug =
+
+        String(name || "project")
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, "-")
+            .replace(/^-+|-+$/g, "")
+            .slice(0, 24);
+
+    return slug || "project";
+
+}
+
+
+function projectIdFor(name, canonicalRoot) {
+
+    const hash =
+        crypto
+            .createHash("sha256")
+            .update(canonicalRoot)
+            .digest("hex")
+            .slice(0, 8);
+
+    return `prj-${slugify(name)}-${hash}`;
+
+}
+
+
+function canonicalizeRoot(rootPath) {
+
+    if (typeof rootPath !== "string" || rootPath.trim() === "") {
+
+        throw new Error(
+            "Project rootPath is required and must be a non-empty string."
+        );
+
+    }
+
+    const resolved = path.resolve(rootPath);
+
+    let stats;
+
+    try {
+
+        stats = fs.statSync(resolved);
+
+    } catch (error) {
+
+        throw new Error(
+            `Project root does not exist: ${rootPath} (${error.code || error.message})`
+        );
+
+    }
+
+    if (!stats.isDirectory()) {
+
+        throw new Error(
+            `Project root is not a directory: ${rootPath}`
+        );
+
+    }
+
+    return fs.realpathSync(resolved);
+
+}
+
+
+class ProjectRegistry {
+
+    constructor({ registryPath } = {}) {
+
+        this.registryPath =
+            registryPath || ProjectStore.resolveRegistryPath();
+
+    }
+
+    _load() {
+
+        return ProjectStore.load(this.registryPath);
+
+    }
+
+    _save(data) {
+
+        ProjectStore.save(data, this.registryPath);
+
+    }
+
+    /*
+    | Register a project. Idempotent on the canonical root: re-registering
+    | an existing root returns the existing record unchanged.
+    */
+    register(config = {}) {
+
+        const canonicalRoot = canonicalizeRoot(config.rootPath);
+
+        const data = this._load();
+
+        for (const existing of Object.values(data.projects)) {
+
+            if (existing.rootPath === canonicalRoot) {
+
+                return cloneProject(existing);
+
+            }
+        }
+
+        const name =
+            typeof config.name === "string" && config.name.trim() !== ""
+                ? config.name.trim()
+                : path.basename(canonicalRoot);
+
+        const id =
+            config.id ||
+            projectIdFor(name, canonicalRoot);
+
+        if (data.projects[id]) {
+
+            throw new Error(
+                `Project id already in use by a different project: ${id}`
+            );
+
+        }
+
+        const record = {
+            id,
+            name,
+            rootPath: canonicalRoot,
+            semanticEndpoint: config.semanticEndpoint ?? null,
+            enabled: config.enabled ?? true,
+            autoStart: config.autoStart ?? true,
+            permissions: {
+                ...DEFAULT_PERMISSIONS,
+                ...(config.permissions || {})
+            },
+            created_at: new Date().toISOString()
+        };
+
+        data.projects[id] = record;
+
+        this._save(data);
+
+        return cloneProject(record);
+
+    }
+
+    get(projectId) {
+
+        const record = this._load().projects[projectId];
+
+        if (!record) {
+
+            throw new Error(
+                `Unknown project: ${projectId}`
+            );
+
+        }
+
+        return cloneProject(record);
+
+    }
+
+    list() {
+
+        const projects = Object.values(this._load().projects);
+
+        return projects
+            .slice()
+            .sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0)
+            .map(cloneProject);
+
+    }
+
+    findByRoot(rootPath) {
+
+        const canonicalRoot = canonicalizeRoot(rootPath);
+
+        for (const record of Object.values(this._load().projects)) {
+
+            if (record.rootPath === canonicalRoot) {
+
+                return cloneProject(record);
+
+            }
+        }
+
+        return null;
+
+    }
+
+    remove(projectId) {
+
+        const data = this._load();
+
+        if (!data.projects[projectId]) {
+
+            throw new Error(
+                `Unknown project: ${projectId}`
+            );
+
+        }
+
+        const removed = data.projects[projectId];
+
+        delete data.projects[projectId];
+
+        this._save(data);
+
+        return cloneProject(removed);
+
+    }
+
+    /*
+    | Patch mutable fields. Identity fields (id, rootPath) cannot be
+    | patched: a new root means a new registration, and a rename keeps
+    | the id — that is what makes references durable.
+    */
+    update(projectId, patch = {}) {
+
+        for (const forbidden of ["id", "rootPath"]) {
+
+            if (Object.prototype.hasOwnProperty.call(patch, forbidden)) {
+
+                throw new Error(
+                    `Project field ${forbidden} is immutable; ` +
+                    (forbidden === "rootPath"
+                        ? "register the new root as its own project instead."
+                        : "ids are fixed at registration time.")
+                );
+
+            }
+        }
+
+        const data = this._load();
+
+        const record = data.projects[projectId];
+
+        if (!record) {
+
+            throw new Error(
+                `Unknown project: ${projectId}`
+            );
+
+        }
+
+        if (typeof patch.name === "string" && patch.name.trim() !== "") {
+
+            record.name = patch.name.trim();
+
+        }
+
+        if (Object.prototype.hasOwnProperty.call(patch, "semanticEndpoint")) {
+
+            record.semanticEndpoint = patch.semanticEndpoint;
+
+        }
+
+        if (typeof patch.enabled === "boolean") {
+
+            record.enabled = patch.enabled;
+
+        }
+
+        if (typeof patch.autoStart === "boolean") {
+
+            record.autoStart = patch.autoStart;
+
+        }
+
+        if (patch.permissions && typeof patch.permissions === "object") {
+
+            record.permissions = {
+                ...record.permissions,
+                ...patch.permissions
+            };
+
+        }
+
+        record.updated_at = new Date().toISOString();
+
+        this._save(data);
+
+        return cloneProject(record);
+
+    }
+
+    /*
+    | The default project keeps today's single-workspace behavior:
+    | if the workspace root is registered, that project is the default;
+    | otherwise a synthetic (unpersisted) project is derived from the
+    | workspace itself with the legacy .agent data layout, which
+    | Phase 8 migrates into the central store.
+    */
+    resolveDefault(workspaceRoot) {
+
+        const canonicalRoot = canonicalizeRoot(workspaceRoot);
+
+        const registered = this.findByRoot(canonicalRoot);
+
+        if (registered) {
+
+            return registered;
+
+        }
+
+        const name = path.basename(canonicalRoot);
+
+        return {
+            id: projectIdFor(name, canonicalRoot),
+            name,
+            rootPath: canonicalRoot,
+            semanticEndpoint: null,
+            enabled: true,
+            autoStart: true,
+            permissions: { ...DEFAULT_PERMISSIONS },
+            synthetic: true
+        };
+
+    }
+
+}
+
+
+function cloneProject(record) {
+
+    return {
+        ...record,
+        permissions: { ...record.permissions }
+    };
+
+}
+
+
+module.exports = {
+    ProjectRegistry,
+    canonicalizeRoot,
+    projectIdFor,
+    DEFAULT_PERMISSIONS
+};
diff --git a/structured-ai/agent/projects/ProjectResolver.js b/structured-ai/agent/projects/ProjectResolver.js
new file mode 100644
index 0000000..b06506e
--- /dev/null
+++ b/structured-ai/agent/projects/ProjectResolver.js
@@ -0,0 +1,129 @@
+"use strict";
+
+const settings = require("../lib/storage");
+
+const { ProjectRegistry, canonicalizeRoot } = require("./ProjectRegistry");
+const { createProjectContext } = require("./ProjectContext");
+
+/*
+|--------------------------------------------------------------------------
+| Project Resolver
+|--------------------------------------------------------------------------
+|
+| Turns the project-ish options a caller may pass (
+|   runAgent({ task, project })            — a registry record or context
+|   runAgent({ task, projectId })          — looked up in the registry
+|   runAgent({ task })                     — the default project
+| ) into exactly one ProjectContext, with one class of clear error text
+| for every failure mode.
+|
+| PROJECT_CONTEXT_MODE=legacy keeps today's behavior: project options are
+| ignored entirely and nothing in the run notices multi-project exists.
+| This is the default until the pool/runtime phases complete (rule 8).
+| The flag is a declared setting (lib/storage), so env, overlay and UI all
+| see the same value.
+|
+*/
+
+
+function projectContextMode() {
+
+    const mode =
+        String(settings.get("PROJECT_CONTEXT_MODE") || "legacy").toLowerCase();
+
+    return mode === "modular" ? "modular" : "legacy";
+
+}
+
+
+function looksLikeProjectRecord(value) {
+
+    return (
+        value &&
+        typeof value === "object" &&
+        typeof value.id === "string" &&
+        typeof value.rootPath === "string"
+    );
+
+}
+
+
+/*
+| Resolve the project context for one run.
+|
+| Throws plain Errors whose messages name the failure:
+|   Unknown project: prj-x            (registry miss)
+|   project must be a registry record (bad shape)
+*/
+function resolveProjectForRun(options = {}, { registry, workspaceRoot } = {}) {
+
+    const activeRegistry =
+        registry || new ProjectRegistry();
+
+    if (looksLikeProjectRecord(options.project)) {
+
+        return createProjectContext(options.project);
+
+    }
+
+    if (options.project) {
+
+        throw new Error(
+            "options.project must be a project record with id and rootPath " +
+            "(get it from projectRegistry.get(...) or register one first)."
+        );
+
+    }
+
+    if (options.projectId !== undefined && options.projectId !== null) {
+
+        const record = activeRegistry.get(options.projectId);
+
+        return createProjectContext(record);
+
+    }
+
+    const defaultRecord =
+        activeRegistry.resolveDefault(
+            workspaceRoot || process.env.WORKSPACE_ROOT || process.cwd()
+        );
+
+    /*
+    | A registered workspace keeps the central dataRoot; only the
+    | synthesized default falls back to the legacy .agent layout.
+    */
+
+    return createProjectContext(defaultRecord);
+
+}
+
+
+/*
+| One canonical mismatch message used while the tool layer still reads the
+| process-wide WORKSPACE_ROOT (until Phase 4). Running a project rooted
+| somewhere else would silently mis-scope every tool call, so it fails
+| loudly instead.
+*/
+function assertWorkspaceMatch(context, workspaceRoot) {
+
+    const canonicalWorkspace = canonicalizeRoot(workspaceRoot);
+
+    if (context.workspaceRoot !== canonicalWorkspace) {
+
+        throw new Error(
+            `Project "${context.projectId}" is rooted at ${context.workspaceRoot}, ` +
+            `but this process is bound to workspace ${canonicalWorkspace}. ` +
+            `Running tools across two roots lands with the project-aware tool runtime ` +
+            `(Phase 4); start the agent on the project root or select a matching project.`
+        );
+
+    }
+
+}
+
+
+module.exports = {
+    projectContextMode,
+    resolveProjectForRun,
+    assertWorkspaceMatch
+};
diff --git a/structured-ai/agent/projects/ProjectStore.js b/structured-ai/agent/projects/ProjectStore.js
new file mode 100644
index 0000000..28e1057
--- /dev/null
+++ b/structured-ai/agent/projects/ProjectStore.js
@@ -0,0 +1,171 @@
+"use strict";
+
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+
+const settings = require("../lib/storage");
+
+/*
+|--------------------------------------------------------------------------
+| Project Store
+|--------------------------------------------------------------------------
+|
+| Owns the on-disk form of the project registry. The registry lives in the
+| user's data home (never inside a workspace, so a workspace can be moved
+| or deleted without losing the agent's knowledge of projects):
+|
+|   ~/.local/share/structured-ai/registry.json
+|
+| overridable through the STRUCTURED_AI_DATA_HOME setting (declared in
+| lib/storage schema — the store's internal contract forbids reading raw
+| env vars outside it).
+|
+| Writes are atomic (temp file + rename) so a crash mid-save can never
+| leave half a registry behind. A corrupt file surfaces as a clear error
+| naming the path, never as a silent reset.
+|
+*/
+
+/*
+| Same convention as the workspace project file (lib/project.js): format
+| versions are strings so they are read as labels, not tunable numbers —
+| and they stay out of the settings store's "no bare numeric constant"
+| boundary.
+*/
+const STORE_VERSION = "1";
+
+
+
+function resolveDataHome() {
+
+    const override = settings.get("STRUCTURED_AI_DATA_HOME");
+
+    if (override) {
+
+        return path.resolve(override);
+
+    }
+
+    return path.join(
+
+        os.homedir(),
+
+        ".local",
+
+        "share",
+
+        "structured-ai"
+    );
+
+}
+
+
+
+function resolveRegistryPath(dataHome = resolveDataHome()) {
+
+    return path.join(dataHome, "registry.json");
+
+}
+
+
+
+function emptyRegistry() {
+
+    return {
+        version: STORE_VERSION,
+        projects: {}
+    };
+
+}
+
+
+
+function load(registryPath = resolveRegistryPath()) {
+
+    if (!fs.existsSync(registryPath)) {
+
+        return emptyRegistry();
+
+    }
+
+    let text;
+
+    try {
+
+        text = fs.readFileSync(registryPath, "utf8");
+
+    } catch (error) {
+
+        throw new Error(
+            `Project registry could not be read from ${registryPath}: ${error.message}`
+        );
+
+    }
+
+    let data;
+
+    try {
+
+        data = JSON.parse(text);
+
+    } catch (error) {
+
+        throw new Error(
+            `Project registry at ${registryPath} is corrupt (invalid JSON): ${error.message}`
+        );
+
+    }
+
+    if (!data || typeof data !== "object" || typeof data.projects !== "object" || data.projects === null) {
+
+        throw new Error(
+            `Project registry at ${registryPath} is corrupt: expected an object with a projects map.`
+        );
+
+    }
+
+    return {
+        version: data.version || STORE_VERSION,
+        projects: data.projects
+    };
+
+}
+
+
+
+function save(registry, registryPath = resolveRegistryPath()) {
+
+    fs.mkdirSync(path.dirname(registryPath), { recursive: true });
+
+    const tempPath = `${registryPath}.tmp-${process.pid}`;
+
+    fs.writeFileSync(
+
+        tempPath,
+
+        JSON.stringify(
+            {
+                version: registry.version || STORE_VERSION,
+                projects: registry.projects
+            },
+            null,
+            2
+        ) + "\n"
+
+    );
+
+    fs.renameSync(tempPath, registryPath);
+
+}
+
+
+
+module.exports = {
+    STORE_VERSION,
+    resolveDataHome,
+    resolveRegistryPath,
+    emptyRegistry,
+    load,
+    save
+};
diff --git a/structured-ai/agent/projects/index.js b/structured-ai/agent/projects/index.js
new file mode 100644
index 0000000..f4283ce
