--- /dev/null
+++ b/structured-ai/agent/prompt/index.js
@@ -0,0 +1,88 @@
+/*
+|--------------------------------------------------------------------------
+| Prompt Kit
+|--------------------------------------------------------------------------
+|
+| Phase 5 of EXECUTION_PLAN: the prompt-building modules, gated by the
+| PROMPT_BUILDER_MODE setting ('legacy' default, 'modular' for the
+| injected builders). Anything above an empty/unknown value behaves as
+| legacy, so a misspelled flag can never silently fork the engine.
+|
+| createPromptBuilder(deps) assembles the facade from injected closures;
+| the resolvers are exported separately because the engine also uses
+| them directly (tools list of a profile, rules filtering).
+|--------------------------------------------------------------------------
+*/
+
+const settings = require("../lib/storage");
+
+const PromptBuilder = require("./PromptBuilder");
+const MainPromptBuilder = require("./MainPromptBuilder");
+const SubAgentPromptBuilder = require("./SubAgentPromptBuilder");
+const RuntimeContextBuilder = require("./RuntimeContextBuilder");
+const ProjectContextBuilder = require("./ProjectContextBuilder");
+const RequestBuilder = require("./RequestBuilder");
+const PromptMessages = require("./PromptMessages");
+const { createToolResolver } = require("./ToolResolver");
+const { createSkillResolver } = require("./SkillResolver");
+
+
+function promptBuilderMode() {
+
+    return (
+        settings.get("PROMPT_BUILDER_MODE") === "modular"
+            ? "modular"
+            : "legacy"
+    );
+
+}
+
+
+function createPromptBuilder(deps) {
+
+    const projectContextBuilder =
+        new ProjectContextBuilder({
+            listProjects: deps.listProjects
+        });
+
+    const runtimeContextBuilder =
+        new RuntimeContextBuilder(deps.runtimeContext);
+
+    const sharedRuntimeContext =
+        () => runtimeContextBuilder.build();
+
+    return new PromptBuilder({
+        mainPromptBuilder:
+            new MainPromptBuilder({
+                ...deps.main,
+                runtimeContext: sharedRuntimeContext,
+                projectContextBuilder
+            }),
+        subAgentPromptBuilder:
+            new SubAgentPromptBuilder({
+                ...deps.subAgent,
+                runtimeContext: sharedRuntimeContext,
+                projectContextBuilder
+            }),
+        runtimeContextBuilder,
+        projectContextBuilder,
+        requestBuilder:
+            new RequestBuilder(deps.request)
+    });
+
+}
+
+
+module.exports = {
+    createPromptBuilder,
+    createToolResolver,
+    createSkillResolver,
+    promptBuilderMode,
+    PromptBuilder,
+    MainPromptBuilder,
+    SubAgentPromptBuilder,
+    RuntimeContextBuilder,
+    ProjectContextBuilder,
+    RequestBuilder,
+    PromptMessages
+};
diff --git a/structured-ai/agent/runtime/AgentRunContext.js b/structured-ai/agent/runtime/AgentRunContext.js
new file mode 100644
index 0000000..b5faebb
--- /dev/null
+++ b/structured-ai/agent/runtime/AgentRunContext.js
@@ -0,0 +1,249 @@
+/*
+|--------------------------------------------------------------------------
+| Agent Run Context
+|--------------------------------------------------------------------------
+|
+| Everything one run owns, nothing another run may see: the identities
+| the run correlates by (run/project/parent/turn), the conversation it
+| builds, and its three lifelines (wall-clock budget, sub-agent spawn
+| budget, cancellation).
+|
+| The class deliberately also exposes the legacy RUN field surface
+| (id, started_at, controller, cancelled_reason, ...) as views over
+| those members. The engine's execution path reads and writes through
+| that surface via currentRun(), which returns this object in modular
+| mode and the untouched global RUN object in legacy mode — so the one
+| code path serves both, and legacy behavior stays byte-identical.
+|--------------------------------------------------------------------------
+*/
+
+const RunCancellation = require("./RunCancellation");
+const { RunBudget, AgentSpawnBudget } = require("./RunBudget");
+
+
+class AgentRunContext {
+
+    constructor({
+        runId = null,
+        project = null,
+        task = "",
+        parentRunId = null,
+        turnId = null,
+        messages = []
+    } = {}) {
+
+        this.runId = runId;
+
+        /* The ProjectContext this run is scoped to (Phase 2); null when
+           a project could not be resolved or the phase-2 mode is legacy. */
+        this.project = project;
+
+        this.task = task;
+
+        this.parentRunId = parentRunId;
+
+        /* The turn currently being executed; a conversational session
+           advances it once per user task inside the same run. */
+        this.turnId = turnId;
+
+        /* The conversation this run is building (the caller-owned
+           history array in a multi-turn session). */
+        this.messages = messages;
+
+        this.budget = new RunBudget();
+
+        this.agentBudget = new AgentSpawnBudget();
+
+        this.cancellation = new RunCancellation();
+
+        /* Session-facing per-run state that is not a budget or a signal:
+           hook outcomes, whether the after hooks already ran, the loaded
+           main-agent definition, the turn counter, and the tool-runtime
+           baggage carried across runs (background processes). */
+        this.hookResults = {};
+
+        this.afterHooksRan = false;
+
+        this.mainAgentDefinition = null;
+
+        this.turnCounter = 0;
+
+        this.carried = null;
+
+        /* Lifecycle bookkeeping filled in by the RunManager. */
+        this.status = "created";
+
+        this.finishedAt = 0;
+
+    }
+
+
+    get projectId() {
+
+        /* Accepts a Phase-2 ProjectContext (projectId) or a bare
+           registry record (id). */
+        if (!this.project) {
+            return null;
+        }
+
+        return (
+            this.project.projectId ??
+            this.project.id ??
+            null
+        );
+
+    }
+
+
+    /*----------------------------------------------------------------
+    | Legacy RUN field surface — views over the members above, so the
+    | shared execution path addressing currentRun().started_at etc.
+    | works identically on this class and on the plain legacy object.
+    |----------------------------------------------------------------*/
+
+    get id() {
+
+        return this.runId;
+
+    }
+
+    set id(value) {
+
+        this.runId = value;
+
+    }
+
+
+    get started_at() {
+
+        return this.budget.startedAt;
+
+    }
+
+    set started_at(value) {
+
+        this.budget.startedAt = value;
+
+    }
+
+
+    get controller() {
+
+        return this.cancellation.controller;
+
+    }
+
+    set controller(value) {
+
+        this.cancellation.controller = value;
+
+    }
+
+
+    get cancelled_reason() {
+
+        return this.cancellation.reason;
+
+    }
+
+    set cancelled_reason(value) {
+
+        this.cancellation.reason = value;
+
+    }
+
+
+    get inHook() {
+
+        return this.budget.inHook;
+
+    }
+
+    set inHook(value) {
+
+        this.budget.inHook = value;
+
+    }
+
+
+    get hook_phase() {
+
+        return this.budget.hookPhase;
+
+    }
+
+    set hook_phase(value) {
+
+        this.budget.hookPhase = value;
+
+    }
+
+
+    get hook_started_at() {
+
+        return this.budget.hookStartedAt;
+
+    }
+
+    set hook_started_at(value) {
+
+        this.budget.hookStartedAt = value;
+
+    }
+
+
+    get hook_deadline_at() {
+
+        return this.budget.hookDeadlineAt;
+
+    }
+
+    set hook_deadline_at(value) {
+
+        this.budget.hookDeadlineAt = value;
+
+    }
+
+
+    get hook_results() {
+
+        return this.hookResults;
+
+    }
+
+    set hook_results(value) {
+
+        this.hookResults = value;
+
+    }
+
+
+    get after_hooks_ran() {
+
+        return this.afterHooksRan;
+
+    }
+
+    set after_hooks_ran(value) {
+
+        this.afterHooksRan = value;
+
+    }
+
+
+    get main_agent_definition() {
+
+        return this.mainAgentDefinition;
+
+    }
+
+    set main_agent_definition(value) {
+
+        this.mainAgentDefinition = value;
+
+    }
+
+}
+
+
+module.exports = AgentRunContext;
diff --git a/structured-ai/agent/runtime/RunBudget.js b/structured-ai/agent/runtime/RunBudget.js
new file mode 100644
index 0000000..22a0c19
--- /dev/null
+++ b/structured-ai/agent/runtime/RunBudget.js
@@ -0,0 +1,129 @@
+/*
+|--------------------------------------------------------------------------
+| Run Budget
+|--------------------------------------------------------------------------
+|
+| The two per-run budgets the engine enforces:
+|
+| RunBudget — the wall-clock budget. It holds the run's start timestamp
+| and the hook-timing fields (a hook swaps the effective deadline while
+| it executes), and derives deadline/remaining/elapsed from them. The
+| deadline is derived, never stored beyond these inputs, so a limit
+| changed mid-run still moves the deadline of a run that is already
+| going — the same semantics as the legacy RUN fields these back.
+|
+| AgentSpawnBudget — the sub-agent budget (the legacy AGENT_BUDGET
+| counter): how many agents this single run may spawn across every depth
+| and branch of its delegation tree.
+|--------------------------------------------------------------------------
+*/
+
+class RunBudget {
+
+    constructor() {
+
+        this.startedAt = 0;
+
+        /* Hook executors borrow the run's deadline while a hook runs. */
+        this.inHook = false;
+
+        this.hookPhase = null;
+
+        this.hookStartedAt = 0;
+
+        this.hookDeadlineAt = null;
+
+    }
+
+
+    /* Mirrors agent.js runDeadlineAt(): hook deadline wins, then the
+       start plus the run limit, and nothing before the run has started. */
+    deadlineAt(maxRunMs) {
+
+        if (this.inHook && this.hookDeadlineAt) {
+            return this.hookDeadlineAt;
+        }
+
+        if (!this.startedAt) {
+            return null;
+        }
+
+        return this.startedAt + maxRunMs;
+
+    }
+
+
+    remainingMs(maxRunMs) {
+
+        const deadline = this.deadlineAt(maxRunMs);
+
+        if (!deadline) {
+            return maxRunMs;
+        }
+
+        return deadline - Date.now();
+
+    }
+
+
+    elapsedMs() {
+
+        return (
+            this.startedAt
+                ? Date.now() - this.startedAt
+                : 0
+        );
+
+    }
+
+}
+
+
+class AgentSpawnBudget {
+
+    constructor() {
+
+        this.spawned = 0;
+
+    }
+
+
+    reset() {
+
+        this.spawned = 0;
+
+    }
+
+
+    remaining(maxTotalAgents) {
+
+        return Math.max(
+            0,
+            maxTotalAgents - this.spawned
+        );
+
+    }
+
+
+    /* Consume one slot; overshooting the limit is an error, not a warn. */
+    consume(maxTotalAgents, agentName) {
+
+        this.spawned++;
+
+        if (this.spawned > maxTotalAgents) {
+
+            throw new Error(
+                `Total agent budget exceeded (${maxTotalAgents}) while starting "${agentName}".`
+            );
+
+        }
+
+    }
+
+}
+
+
+module.exports = {
+    RunBudget,
+    AgentSpawnBudget
+};
diff --git a/structured-ai/agent/runtime/RunCancellation.js b/structured-ai/agent/runtime/RunCancellation.js
new file mode 100644
index 0000000..7962f50
--- /dev/null
+++ b/structured-ai/agent/runtime/RunCancellation.js
@@ -0,0 +1,70 @@
+/*
+|--------------------------------------------------------------------------
+| Run Cancellation
+|--------------------------------------------------------------------------
+|
+| One run's cancellation state: the AbortController whose signal every
+| in-flight request and tool of that run observes, and the reason the
+| run was stopped.
+|
+| This is the same lifecycle the legacy global RUN object carries on its
+| controller/cancelled_reason fields; isolating it per run is what makes
+| "cancel run A without touching run B" possible. The hook executor swaps
+| the controller while a hook runs and restores it afterwards, exactly as
+| the legacy RUN fields do, so both swaps are plain property writes here.
+|--------------------------------------------------------------------------
+*/
+
+class RunCancellation {
+
+    constructor() {
+
+        this.controller = null;
+
+        this.reason = null;
+
+    }
+
+
+    /* A run starts uncancellable until startRun attaches a controller. */
+    get signal() {
+
+        return (
+            this.controller
+                ? this.controller.signal
+                : null
+        );
+
+    }
+
+
+    get isCancelled() {
+
+        return Boolean(
+            this.controller &&
+            this.controller.signal.aborted
+        );
+
+    }
+
+
+    /* Idempotent: an already-stopped run keeps its first reason. */
+    abort() {
+
+        if (
+            !this.controller ||
+            this.controller.signal.aborted
+        ) {
+            return false;
+        }
+
+        this.controller.abort();
+
+        return true;
+
+    }
+
+}
+
+
+module.exports = RunCancellation;
diff --git a/structured-ai/agent/runtime/RunManager.js b/structured-ai/agent/runtime/RunManager.js
new file mode 100644
index 0000000..4ced87c
--- /dev/null
+++ b/structured-ai/agent/runtime/RunManager.js
@@ -0,0 +1,206 @@
+/*
+|--------------------------------------------------------------------------
+| Run Manager
+|--------------------------------------------------------------------------
+|
+| Owns the lifecycle of runs: it creates their AgentRunContext, tracks
+| which are active, runs each one inside its own async scope, and lets a
+| caller finish or cancel a specific run by id.
+|
+| Isolation comes from two async-local scopes entered together per run:
+|
+| - this module's store carries { run: ctx }, so the engine's
+|   currentRun() resolves to the calling run's context wherever the
+|   flow awaits (model requests, tool calls, deadline timers);
+|
+| - the events module's scope carries the correlation envelope
+|   (run_id, project_id, ...), so concurrent runs can never swap each
+|   other's event attribution through the process-global context.
+|
+| In legacy mode this machinery is never entered: runAgent keeps its
+| historical body and currentRun() falls back to the global RUN.
+|--------------------------------------------------------------------------
+*/
+
+const { AsyncLocalStorage } = require("async_hooks");
+
+const AgentRunContext = require("./AgentRunContext");
+const events = require("../lib/events");
+const settings = require("../lib/storage");
+
+
+const runScope = new AsyncLocalStorage();
+
+
+class RunManager {
+
+    constructor() {
+
+        this.active = new Map();
+
+        this.finished = new Map();
+
+    }
+
+
+    /* The run context of the current async chain, or null outside any
+       run scope (legacy mode, request handlers, startup). */
+    current() {
+
+        const store = runScope.getStore();
+
+        return store ? store.run : null;
+
+    }
+
+
+    get(runId) {
+
+        return (
+            this.active.get(runId) ||
+            this.finished.get(runId) ||
+            null
+        );
+
+    }
+
+
+    activeRuns() {
+
+        return [...this.active.values()];
+
+    }
+
+
+    /* The legacy run id format; a suffix keeps ids unique when two runs
+       begin within the same millisecond. */
+    issueRunId() {
+
+        const base =
+            `run-${new Date(Date.now()).toISOString()
+                .replace(/[:.]/g, "-")}`;
+
+        let candidate = base;
+
+        let collision = 0;
+
+        while (
+            this.active.has(candidate) ||
+            this.finished.has(candidate)
+        ) {
+
+            collision++;
+
+            candidate = `${base}-r${collision}`;
+
+        }
+
+        return candidate;
+
+    }
+
+
+    createRun({
+        task = "",
+        parentRunId = null,
+        project = null,
+        turnId = null,
+        messages = []
+    } = {}) {
+
+        const context =
+
+            new AgentRunContext({
+                runId: this.issueRunId(),
+                project,
+                task,
+                parentRunId,
+                turnId,
+                messages
+            });
+
+        return context;
+
+    }
+
+
+    /* Runs fn inside both async scopes, tracks the run for its whole
+       lifetime, and settles its bookkeeping exactly once. */
+    async execute(context, fn) {
+
+        this.active.set(context.runId, context);
+
+        context.status = "running";
+
+        try {
+
+            return await runScope.run(
+
+                { run: context },
+
+                () => events.runWithScope(
+                    {
+                        run_id: context.runId,
+                        project_id: context.projectId
+                    },
+                    () => fn(context)
+                )
+
+            );
+
+        } catch (error) {
+
+            context.status =
+                context.cancellation.isCancelled
+                    ? "cancelled"
+                    : "failed";
+
+            throw error;
+
+        } finally {
+
+            context.finishedAt = Date.now();
+
+            if (context.status === "running") {
+
+                context.status =
+                    context.cancellation.isCancelled
+                        ? "cancelled"
+                        : "completed";
+
+            }
+
+            this.active.delete(context.runId);
+
+            this.finished.set(context.runId, context);
+
+            /* Kept finished runs let a caller ask "what became of run
+               X?" shortly after it settled, without growing memory for
+               the process lifetime. */
+            while (
+                this.finished.size >
+                settings.get("RUN_HISTORY_LIMIT")
+            ) {
+
+                this.finished.delete(
+                    this.finished.keys().next().value
+                );
+
+            }
+
+        }
+
+    }
+
+}
+
+
+/* One manager per process: the engine module and anything it hands the
+   runtime to must agree on which runs exist. */
+const runManager = new RunManager();
+
+
+module.exports = {
+    RunManager,
+    runManager
+};
diff --git a/structured-ai/agent/runtime/index.js b/structured-ai/agent/runtime/index.js
new file mode 100644
index 0000000..c2d484f
--- /dev/null
+++ b/structured-ai/agent/runtime/index.js
@@ -0,0 +1,40 @@
+/*
+|--------------------------------------------------------------------------
+| Runtime (per-run context)
+|--------------------------------------------------------------------------
+|
+| Phase 3 of EXECUTION_PLAN: the per-run context modules, gated by the
+| RUN_CONTEXT_MODE setting ('legacy' default, 'modular' for isolated
+| concurrent runs). Anything above an empty/unknown value behaves as
+| legacy, so a misspelled flag can never silently fork the engine.
+|--------------------------------------------------------------------------
+*/
+
+const settings = require("../lib/storage");
+
+const AgentRunContext = require("./AgentRunContext");
+const RunCancellation = require("./RunCancellation");
+const { RunBudget, AgentSpawnBudget } = require("./RunBudget");
+const { RunManager, runManager } = require("./RunManager");
+
+
+function runContextMode() {
+
+    return (
+        settings.get("RUN_CONTEXT_MODE") === "modular"
+            ? "modular"
+            : "legacy"
+    );
+
+}
+
+
+module.exports = {
+    AgentRunContext,
+    RunCancellation,
+    RunBudget,
+    AgentSpawnBudget,
+    RunManager,
+    runManager,
+    runContextMode
+};
diff --git a/structured-ai/agent/tools/ToolContext.js b/structured-ai/agent/tools/ToolContext.js
new file mode 100644
index 0000000..dd2adb4
--- /dev/null
+++ b/structured-ai/agent/tools/ToolContext.js
@@ -0,0 +1,259 @@
+/*
+|--------------------------------------------------------------------------
+| Tool Execution Context
+|--------------------------------------------------------------------------
+|
+| What a tool needs to act on the right project: the agent on whose
+| behalf it runs, the run it belongs to, and the ProjectContext that
+| supplies the filesystem boundary.
+|
+| The context is BUILT BY THE RUNTIME from its own run state and handed
+| to executeTool as the third argument — a tool call's arguments never
+| carry identity fields, so the model can neither name another project
+| nor forge one (EXECUTION_PLAN rule 9).
+|
+| Modes:
+|   legacy  — no project context: every helper is pinned to the
+|             process-wide WORKSPACE_ROOT via the historical workspace
+|             functions, so behaviour is bit-identical to before.
+|   modular — PROJECT_CONTEXT_MODE=modular makes a valid project context
+|             mandatory: a tool that runs without one has no boundary
+|             and must fail loudly instead of resolving against the
+|             wrong root.
+|
+|--------------------------------------------------------------------------
+*/
+
+const fs = require("fs");
+
+const {
+    WORKSPACE_ROOT,
+    realpath,
+    isInsideRoot,
+    resolveWorkspacePath,
+    assertWorkspacePathSafe,
+    toWorkspaceRelative,
+    resolvePathInRoot,
+    assertPathSafeInRoot,
+    toRelativeInRoot
+} = require("../lib/workspace");
+
+const settings = require("../lib/storage");
+
+
+class ToolContext {
+
+    constructor({ agent, runId, project }) {
+
+        this.agent = agent;
+
+        this.runId = runId || null;
+
+        this.project = project || null;
+
+        this.scoped = Boolean(project);
+
+        /* Best-effort canonicalisation: an existing root is resolved
+           through symlinks so prefix comparisons match what the kernel
+           will open; a missing root stays textual and simply fails the
+           first real resolution with the documented error text. */
+        this.root =
+
+            canonicalRoot(
+                this.scoped
+                    ? project.workspaceRoot
+                    : WORKSPACE_ROOT
+            );
+
+    }
+
+
+    get projectId() {
+
+        return (
+            this.project
+                ? (this.project.projectId ?? this.project.id ?? null)
+                : null
+        );
+
+    }
+
+
+    resolvePath(inputPath, options = {}) {
+
+        return (
+            this.scoped
+                ? resolvePathInRoot(this.root, inputPath, options)
+                : resolveWorkspacePath(inputPath, options)
+        );
+
+    }
+
+
+    assertSafe(target, options = {}) {
+
+        return (
+            this.scoped
+                ? assertPathSafeInRoot(this.root, target, options)
+                : assertWorkspacePathSafe(target, options)
+        );
+
+    }
+
+
+    isInside(target) {
+
+        return isInsideRoot(this.root, target);
+
+    }
+
+
+    relative(target) {
+
+        return (
+            this.scoped
+                ? toRelativeInRoot(this.root, target)
+                : toWorkspaceRelative(target)
+        );
+
+    }
+
+
+    /* The workspace pin is used for "in this process the two roots are
+       the same directory" checks (pending tool awareness gate). */
+    sharesWorkspaceRoot() {
+
+        return this.root === canonicalRoot(WORKSPACE_ROOT);
+
+    }
+
+}
+
+
+function canonicalRoot(root) {
+
+    try {
+
+        if (fs.existsSync(root)) {
+            return realpath(root);
+        }
+
+    } catch {
+        /* fall through to the textual root */
+    }
+
+    return root;
+
+}
+
+
+/* Rule 9 enforcement: identity may arrive via the runtime context, and
+   nowhere else — a project id that shows up as a tool ARGUMENT (i.e.
+   came from the model) is a failure, not an override. */
+const ARGUMENT_IDENTITY_FIELDS =
+    Object.freeze(["projectId", "project_id", "project", "projectRoot", "root"]);
+
+
+function assertNoIdentityArguments(args) {
+
+    if (!args || typeof args !== "object") {
+        return;
+    }
+
+    for (const field of ARGUMENT_IDENTITY_FIELDS) {
+
+        if (Object.prototype.hasOwnProperty.call(args, field)) {
+
+            throw new Error(
+                `Tool argument "${field}" is not allowed: project identity is ` +
+                "supplied by the run context, never by model or user arguments (rule 9)."
+            );
+
+        }
+    }
+}
+
+
+/* Normalizes the raw executeTool context into a ToolContext. In legacy
+   mode an absent one simply means the historical workspace-pinned
+   context, so tools can use the helpers unconditionally. A raw context
+   that CONTRADICTS itself (a project id with no context, a context
+   without a root) fails loudly — that only happens through a runtime
+   bug or a forged call, and both deserve errors, not entropy. */
+function from(raw) {
+
+    /* executeTool hands implementations the normalized context
+       already; re-wrapping it is an identity no-op. */
+    if (raw instanceof ToolContext) {
+        return raw;
+    }
+
+    if (!raw || typeof raw !== "object") {
+
+        if (settings.get("PROJECT_CONTEXT_MODE") === "modular") {
+
+            throw new Error(
+                "Tool execution requires a valid project context in modular project mode; " +
+                "the runtime must pass { agent, runId, projectId, projectContext } to executeTool."
+            );
+
+        }
+
+        return new ToolContext({
+            agent: undefined,
+            runId: null,
+            project: null
+        });
+
+    }
+
+    const project =
+        raw.projectContext ??
+        raw.project_context ??
+        null;
+
+    if (project) {
+
+        if (
+            typeof project !== "object" ||
+            typeof project.workspaceRoot !== "string" ||
+            project.workspaceRoot === ""
+        ) {
+
+            throw new Error(
+                "Invalid tool context: the project context carries no workspaceRoot; " +
+                "a tool cannot determine its filesystem boundary."
+            );
+
+        }
+
+    } else if (raw.projectId || raw.project_id) {
+
+        throw new Error(
+            "Invalid tool context: a projectId without a project context; " +
+            "the id alone cannot resolve anything (rule 9)."
+        );
+
+    } else if (settings.get("PROJECT_CONTEXT_MODE") === "modular") {
+
+        throw new Error(
+            "Tool execution requires a valid project context in modular project mode; " +
+            `tool call for agent "${raw.agent || "unknown"}" arrived without one.`
+        );
+
+    }
+
+    return new ToolContext({
+        agent: raw.agent,
+        runId: raw.runId ?? raw.run_id ?? null,
+        project
+    });
+
+}
+
+
+module.exports = {
+    ToolContext,
+    from,
+    assertNoIdentityArguments
+};
