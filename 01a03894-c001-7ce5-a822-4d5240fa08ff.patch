+
+        const raw = {
+            seq: 41,
+            type: "run:start",
+            at: 1760000000000,
+            run_id: "run-2026-08-25T11:22:33.123Z-x9",
+            turn_id: "run-2026-08-25T11:22:33.123Z-x9_t1",
+            scope: "main_agent",
+            iteration: 1,
+            task: "Read /tmp/agent-contract-events-AbC123/notes.md",
