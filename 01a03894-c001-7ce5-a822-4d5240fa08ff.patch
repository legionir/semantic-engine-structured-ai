+++ b/structured-ai/test/helpers/normalize.test.js
@@ -0,0 +1,160 @@
+"use strict";
+
+/*
+|--------------------------------------------------------------------------
+| Normalizer Unit Tests — EXECUTION_PLAN Phase 1
+|--------------------------------------------------------------------------
+|
+| The normalizer defines what "equal output" means for every regression
+| comparison in the plan. Its own behavior is therefore locked here, using
+| realistic runtime samples rather than synthetic trivia.
+|
+*/
+
+const assert = require("assert");
+const path = require("path");
+
+const { normalize, normalizeJson, VOLATILE_KEYS } =
+    require(path.join(__dirname, "normalize.js"));
+
+const results = [];
+
+async function test(name, fn) {
+
+    try {
+
+        await fn();
+
+        results.push({ name, ok: true });
+
+        console.log(`  ok   ${name}`);
+
+    } catch (error) {
+
+        results.push({ name, ok: false, error });
+
+        console.log(`  FAIL ${name}`);
+        console.log(`       ${error.message}`);
+
+    }
+}
+
+
+async function main() {
+
+    await test("ISO timestamps, run ids, temp paths and pids collapse to tokens", async () => {
+
+        const raw =
+            'run run-2026-08-25T11:22:33.123Z-x9 at 2026-08-25T11:22:35.000Z ' +
+            'read /tmp/agent-runtime-test-Abc12/notes.md pid: 4242';
+
+        const out = normalize(raw);
+
+        for (const token of ["<RUN_ID>", "<TSTAMP>", "<TMP>", "pid=<PID>"]) {
+
+            assert.ok(out.includes(token), `missing token ${token} in: ${out}`);
+
+        }
+
+        assert.ok(!out.includes("4242"), "pid leaked past the normalizer");
+        assert.ok(!out.includes("/tmp/"), "temp path leaked past the normalizer");
+
+    });
+
+    await test("workspace replacement wins over the temp-dir rule", async () => {
+
+        const workspace = "/tmp/agent-runtime-test-Work99";
+
+        const out = normalize(
+            `${workspace}/src/index.js`,
+            { workspace }
+        );
+
+        assert.equal(out, "<WORK>/src/index.js");
+
+    });
+
+    await test("volatile numbers are key-driven; contractual numbers survive", async () => {
+
+        const raw = {
+            at: 1760000000000,
+            duration_ms: 350,
+            seq: 12,
+            iteration: 3,
+            max_iterations: 50,
+            count: 7
+        };
+
+        const out = normalize(raw);
+
+        assert.equal(out.at, "<EPOCH>");
+        assert.equal(out.duration_ms, "<VOL>");
+        assert.equal(out.seq, "<VOL>");
+        assert.equal(out.iteration, 3);
+        assert.equal(out.max_iterations, 50);
+        assert.equal(out.count, 7);
+
+    });
+
+    await test("object keys are sorted recursively and array order is preserved", async () => {
+
+        const raw = {
+            zeta: 1,
+            alpha: { beta: 2, aardvark: 3 },
+            list: [{ y: 1, a: 2 }, { b: 1, a: 1 }]
+        };
+
+        const out = normalize(raw);
+
+        assert.deepStrictEqual(Object.keys(out), ["alpha", "list", "zeta"]);
+        assert.deepStrictEqual(Object.keys(out.alpha), ["aardvark", "beta"]);
+
+        /* arrays keep order — messages, tool calls and events are contractual */
+
+        assert.equal(out.list[0].y, 1);
+        assert.equal(out.list[1].b, 1);
+        assert.deepStrictEqual(Object.keys(out.list[0]), ["a", "y"]);
+
+    });
+
+    await test("normalizeJson accepts raw provider payloads", async () => {
+
+        const body = JSON.stringify({
+            run_id: "run-2026-08-25T01:01:01.000Z-aa",
+            turn_id: "t1",
+            task: "read /tmp/x/file.txt",
+            at: 1760000000123
+        });
+
+        const out = normalizeJson(body);
+
+        assert.equal(out.run_id, "<RUN_ID>");
+        assert.equal(out.at, "<EPOCH>");
+        assert.equal(out.turn_id, "t1");
+
+    });
+
+    await test("epochs below the threshold are not mistaken for timestamps", async () => {
+
+        const raw = { retries: 3, budget_remaining: 240000, at: 1760000000123 };
+
+        const out = normalize(raw);
+
+        assert.equal(out.retries, 3);
+        assert.equal(out.budget_remaining, 240000);
+        assert.equal(out.at, "<EPOCH>");
+
+        assert.ok(VOLATILE_KEYS.has("duration_ms"));
+
+    });
+
+    console.log(`\n${results.filter(item => item.ok).length}/${results.length} passed`);
+
+    if (results.some(item => !item.ok)) {
+
+        process.exitCode = 1;
+
+    }
+}
+
+main();
diff --git a/structured-ai/test/helpers/stubSemanticGateway.js b/structured-ai/test/helpers/stubSemanticGateway.js
new file mode 100644
index 0000000..aba8248
--- /dev/null
+++ b/structured-ai/test/helpers/stubSemanticGateway.js
@@ -0,0 +1,300 @@
+const http = require("http");
+
+
+/*
+|--------------------------------------------------------------------------|
+| Stub Semantic Gateway (test-only)                                        |
+|--------------------------------------------------------------------------|
+|
+| EXECUTION_PLAN, Phase 6 گام ۴: the engine-side Worker Supervisor /
+| Gateway described in MULTI_PROJECT_GATEWAY_PLAN.md is not implemented
+| yet (recorded decision, 2026-08-25). This stub serves the contract the
+| agent runtime depends on — POST /mcp/:projectId speaking MCP over
+| Streamable HTTP (initialize, tools/list, tools/call) — so pool
+| development and isolation tests are not blocked on the real gateway.
+|
+| It is deliberately minimal:
+|
+|   - at least two project ids can be registered, each with its OWN
+|     answers, so a routing bug shows up as cross-contaminated symbols;
+|   - every tool result carries additive markers { projectId,
+|     indexGeneration } in structuredContent, mirroring the gateway
+|     plan's "پاسخ شامل projectId و indexGeneration" rule;
+|   - unknown urls/methods fail with plain HTTP errors, never with a
+|     made-up success;
+|   - request counts are exposed per project per tool so cache tests
+|     can tell a memoized call from a fresh request.
+|
+| Production never loads this file (it lives under test/).
+|--------------------------------------------------------------------------
+*/
+
+function createStubSemanticGateway(projects) {
+
+    const registry =
+
+        new Map(
+            Object.entries(projects || {}).map(
+                ([projectId, spec]) => [
+                    projectId,
+                    {
+                        tools: spec.tools || [],
+                        handlers: spec.handlers || {},
+                        generation:
+                            spec.generation !== undefined
+                                ? spec.generation
+                                : 1,
+                        counts: new Map()
+                    }
+                ]
+            )
+        );
+
+
+    function answer(projectId, message) {
+
+        const project = registry.get(projectId);
+
+        if (message.method === "initialize") {
+
+            return {
+                protocolVersion: "2025-06-18",
+                capabilities: { tools: {} },
+                serverInfo: {
+                    name: "stub-semantic-gateway",
+                    version: "0.1.0",
+                    projectId
+                }
+            };
+
+        }
+
+        if (message.method === "tools/list") {
+
+            return { tools: project.tools };
+
+        }
+
+        if (message.method === "tools/call") {
+
+            const name =
+                (message.params && message.params.name) || "";
+
+            const params =
+                (message.params && message.params.arguments) || {};
+
+            project.counts.set(
+                name,
+                (project.counts.get(name) || 0) + 1
+            );
+
+            const handler = project.handlers[name];
+
+            const payload =
+
+                handler
+                    ? handler(params, projectId)
+                    : {
+                          ok: false,
+                          error:
+                              `stub gateway has no handler for "${name}" ` +
+                              `on project "${projectId}"`
+                      };
+
+            return {
+                structuredContent: {
+                    projectId,
+                    indexGeneration: project.generation,
+                    ...(payload && typeof payload === "object"
+                        ? payload
+                        : { value: payload })
+                }
+            };
+
+        }
+
+        const error = new Error(`stub gateway cannot serve "${message.method}"`);
+
+        error.statusCode = 400;
+
+        throw error;
+
+    }
+
+
+    const server =
+
+        http.createServer((req, res) => {
+
+            const parsed =
+
+                new URL(req.url || "/", "http://stub-semantic-gateway");
+
+            const match =
+
+                /^\/mcp\/([^/]+)\/?$/.exec(parsed.pathname);
+
+            if (req.method !== "POST" || !match) {
+
+                res.writeHead(404, { "content-type": "application/json" });
+                res.end(JSON.stringify({ error: "not found" }));
+
+                return;
+
+            }
+
+            const projectId = decodeURIComponent(match[1]);
+
+            if (!registry.has(projectId)) {
+
+                res.writeHead(404, { "content-type": "application/json" });
+                res.end(
+                    JSON.stringify({
+                        error: `unknown project "${projectId}"`
+                    })
+                );
+
+                return;
+
+            }
+
+            let body = "";
+
+            req.on("data", chunk => (body += chunk));
+
+            req.on("end", () => {
+
+                let message;
+
+                try {
+
+                    message = JSON.parse(body || "{}");
+
+                } catch {
+
+                    res.writeHead(400, { "content-type": "application/json" });
+                    res.end(JSON.stringify({ error: "body is not JSON" }));
+
+                    return;
+
+                }
+
+                /* A notification has no id and gets no response body —
+                   exactly what the transport's readJson path treats as a
+                   quiet 202. */
+                if (message.id === undefined || message.id === null) {
+
+                    res.writeHead(202);
+                    res.end();
+
+                    return;
+
+                }
+
+                try {
+
+                    const result = answer(projectId, message);
+
+                    res.writeHead(200, { "content-type": "application/json" });
+                    res.end(
+                        JSON.stringify({
+                            jsonrpc: "2.0",
+                            id: message.id,
+                            result
+                        })
+                    );
+
+                } catch (error) {
+
+                    res.writeHead(error.statusCode || 500, {
+                        "content-type": "application/json"
+                    });
+                    res.end(JSON.stringify({ error: error.message }));
+
+                }
+
+            });
+
+        });
+
+
+    function listen() {
+
+        return new Promise(resolve => {
+
+            server.listen(0, "127.0.0.1", () => resolve(gateway));
+
+        });
+
+    }
+
+
+    const gateway = {
+
+        server,
+
+        listen,
+
+        close() {
+
+            return new Promise(resolve => server.close(resolve));
+
+        },
+
+        port() {
+
+            const address = server.address();
+
+            return address ? address.port : null;
+
+        },
+
+        /* The endpoint a registry record would carry for this project —
+           changing it later is a registry data edit, not a client code
+           change (acceptance of گام ۴). */
+        endpointFor(projectId) {
+
+            return `http://127.0.0.1:${this.port()}/mcp/${encodeURIComponent(projectId)}`;
+
+        },
+
+        /* How often the worker actually saw this tool for this project;
+           the difference between "cached" and "fresh" in pool tests. */
+        callCount(projectId, toolName) {
+
+            const project = registry.get(projectId);
+
+            return project ? project.counts.get(toolName) || 0 : 0;
+
+        },
+
+        /* Simulate the worker reindexing: every subsequent answer from
+           this project reports the new generation, which is what a pool
+           client must react to by dropping cached results. */
+        bumpIndexGeneration(projectId) {
+
+            const project = registry.get(projectId);
+
+            if (!project) {
+
+                throw new Error(`unknown stub project "${projectId}"`);
+
+            }
+
+            project.generation += 1;
+
+            return project.generation;
+
+        }
+
+    };
+
+
+    return gateway;
+
+}
+
+
+module.exports = {
+    createStubSemanticGateway
+};
diff --git a/structured-ai/test/persistence/project-stores.test.js b/structured-ai/test/persistence/project-stores.test.js
