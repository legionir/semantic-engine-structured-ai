+++ b/structured-ai/agent/projects/index.js
@@ -0,0 +1,48 @@
+"use strict";
+
+/*
+|--------------------------------------------------------------------------
+| Projects — public surface
+|--------------------------------------------------------------------------
+|
+| One lazily-built registry instance for the process (data home from
+| ProjectStore.resolveDataHome()), plus the class/pure helpers for tests
+| and future injection.
+|
+*/
+
+const { ProjectRegistry } = require("./ProjectRegistry");
+const ProjectStore = require("./ProjectStore");
+const { createProjectContext } = require("./ProjectContext");
+const {
+    projectContextMode,
+    resolveProjectForRun,
+    assertWorkspaceMatch
+} = require("./ProjectResolver");
+const ProjectMigration = require("./ProjectMigration");
+
+let defaultRegistry = null;
+
+function registry() {
+
+    if (!defaultRegistry) {
+
+        defaultRegistry = new ProjectRegistry();
+
+    }
+
+    return defaultRegistry;
+
+}
+
+
+module.exports = {
+    ProjectRegistry,
+    ProjectStore,
+    ProjectMigration,
+    createProjectContext,
+    projectContextMode,
+    resolveProjectForRun,
+    assertWorkspaceMatch,
+    registry
+};
diff --git a/structured-ai/agent/prompt/MainPromptBuilder.js b/structured-ai/agent/prompt/MainPromptBuilder.js
new file mode 100644
index 0000000..06fdaca
--- /dev/null
+++ b/structured-ai/agent/prompt/MainPromptBuilder.js
@@ -0,0 +1,169 @@
+/*
+|--------------------------------------------------------------------------
+| Main Prompt Builder
+|--------------------------------------------------------------------------
+|
+| The orchestrator's opening messages, moved out of agent.js
+| (EXECUTION_PLAN Phase 5, گام ۲). Message order is contractual:
+|
+|   1. system prompt (text)
+|   2. execution rules (text)
+|   3. runtime_context (JSON)
+|   3a. project_context (JSON — additive, only when a project is scoped)
+|   4. available_skills (JSON)
+|   5. available_personas (JSON, only when the agent may delegate)
+|   6. available_agents (JSON)
+|   7. task (user)
+|
+| Every section arrives as an injected closure so registry edits and
+| text-file changes remain visible without a restart, exactly as
+| before.
+|--------------------------------------------------------------------------
+*/
+
+const { jsonSystem } = require("./PromptMessages");
+
+
+class MainPromptBuilder {
+
+    constructor(deps) {
+
+        this.deps = deps;
+
+    }
+
+
+    build(task, { project } = {}) {
+
+        const deps = this.deps;
+
+        const projectMessage =
+            deps.projectContextBuilder.build(project);
+
+        return [
+
+            {
+                role: "system",
+                content:
+                    deps.systemPrompt()
+            },
+
+            {
+                role: "system",
+                content:
+                    deps.executionRules()
+            },
+
+            jsonSystem({
+                type:
+                    "runtime_context",
+
+                context:
+                    deps.runtimeContext()
+            }),
+
+            projectMessage,
+
+            jsonSystem({
+                type:
+                    "available_skills",
+
+                note:
+                    "Names and descriptions only. Call skill_get before doing that kind of work to read its procedure and constraints.",
+
+                skills:
+                    deps.skillIndex()
+            }),
+
+            /*
+            | Personas exist so an ad-hoc agent can be composed. An
+            | agent that may not delegate has no use for the catalogue,
+            | so it is added below only when it can.
+            |
+            | Discussion personas are left out on purpose: they are not
+            | delegation targets, they are run by the discussion engine
+            | through discussion_start, and advertising all sixteen of
+            | them would tax every request for a flow the orchestrator
+            | reaches with a single tool call.
+            */
+
+            deps.mayDelegate()
+                ? jsonSystem({
+                      type:
+                          "available_personas",
+
+                      note:
+                          "For composing an ad-hoc agent when no profile fits.",
+
+                      personas:
+                          deps.PERSONAS_OF()
+                              .filter(
+                                  persona =>
+                                      !deps.discussionPersonaNames().has(
+                                          persona.name
+                                      )
+                              )
+                              .map(
+                                  persona => ({
+                                      name:
+                                          persona.name,
+
+                                      description:
+                                          persona.description
+                                  })
+                              )
+                  })
+                : null,
+
+            jsonSystem({
+                type:
+                    "available_agents",
+
+                agents:
+                    deps.AGENTS_OF()
+                        .filter(
+                            agent =>
+                                agent.name !==
+                                    "main_agent" &&
+                                !agent.name.startsWith(
+                                    "discussion_"
+                                )
+                        )
+                        .map(
+                        /*
+                        | What choosing a specialist needs: what it
+                        | is for and what it is allowed to do. Its
+                        | output contract, its skills and its tool
+                        | list are the sub-agent's own business, and
+                        | were 3K characters of every request.
+                        */
+
+                        agent => ({
+                            name:
+                                agent.name,
+
+                            description:
+                                agent.description,
+
+                            ...deps.describeCapability(agent),
+
+                            can_delegate:
+                                Boolean(agent.delegation?.enabled)
+                        })
+                    )
+            }),
+
+            {
+                role: "user",
+                content:
+                    task && task.trim() !== ""
+                        ? task
+                        : deps.readTask()
+            }
+        ].filter(Boolean);
+    }
+
+}
+
+
+module.exports = MainPromptBuilder;
diff --git a/structured-ai/agent/prompt/ProjectContextBuilder.js b/structured-ai/agent/prompt/ProjectContextBuilder.js
new file mode 100644
index 0000000..2f135f1
--- /dev/null
+++ b/structured-ai/agent/prompt/ProjectContextBuilder.js
@@ -0,0 +1,90 @@
+/*
+|--------------------------------------------------------------------------
+| Project Context Builder
+|--------------------------------------------------------------------------
+|
+| The additive project_context system message (EXECUTION_PLAN Phase 5,
+| گام ۳). It tells the model which project the run is scoped to, which
+| other projects exist (names and ids only — never guessed paths), and
+| the three operating rules the multi-project documents mandate:
+|
+|   1. work only on the active project
+|   2. never guess another project's paths
+|   3. attribute work to the project it belongs to
+|
+| The message exists only when a project is actually scoped (modular
+| modes); a null build leaves the prompt byte-identical to the legacy
+| one.
+|--------------------------------------------------------------------------
+*/
+
+const { jsonSystem } = require("./PromptMessages");
+
+
+class ProjectContextBuilder {
+
+    constructor({ listProjects }) {
+
+        /* () => registered project records; names and ids only reach
+           the message, roots never do. */
+        this.listProjects = listProjects;
+
+    }
+
+
+    build(project) {
+
+        if (!project) {
+            return null;
+        }
+
+        const projectId =
+            project.projectId ??
+            project.id ??
+            null;
+
+        const available =
+
+            (this.listProjects() || [])
+                .filter(record => record && record.id !== projectId)
+                .map(record => ({
+                    id: record.id,
+                    name: record.name
+                }));
+
+        const payload = {
+            type:
+                "project_context",
+
+            project: {
+                id:
+                    projectId,
+
+                name:
+                    project.projectName ??
+                    project.name ??
+                    null,
+
+                workspace_root:
+                    project.workspaceRoot
+            },
+
+            ...(available.length > 0
+                ? { available_projects: available }
+                : {}),
+
+            rules: [
+                "Work only within the active project: every tool is scoped to the project this run belongs to.",
+                "Never guess, construct, or request paths of another project; projects other than the active one are not reachable by tools.",
+                "Attribute every artifact, result, and claim to the project it belongs to."
+            ]
+        };
+
+        return jsonSystem(payload);
+
+    }
+
+}
+
+
+module.exports = ProjectContextBuilder;
diff --git a/structured-ai/agent/prompt/PromptBuilder.js b/structured-ai/agent/prompt/PromptBuilder.js
new file mode 100644
index 0000000..6ff0e51
--- /dev/null
+++ b/structured-ai/agent/prompt/PromptBuilder.js
@@ -0,0 +1,104 @@
+/*
+|--------------------------------------------------------------------------
+| Prompt Builder (facade)
+|--------------------------------------------------------------------------
+|
+| One narrow surface for everything the runtime asks about prompts:
+| main and sub-agent opening messages, the dynamic runtime context and
+| its per-iteration refresh, the additive project message, and the
+| model request body. Composes the specialised builders; knows neither
+| agent.js globals nor how its dependencies fetch live state — those
+| closures are supplied by whoever creates it (the engine wires them to
+| its own live views).
+|
+| Reached through PROMPT_BUILDER_MODE=modular; the legacy code paths
+| stay untouched beside it until the parity evidence of this phase and
+| the final cleanup phase remove them.
+|--------------------------------------------------------------------------
+*/
+
+class PromptBuilder {
+
+    constructor({
+        mainPromptBuilder,
+        subAgentPromptBuilder,
+        runtimeContextBuilder,
+        projectContextBuilder,
+        requestBuilder
+    }) {
+
+        this.main = mainPromptBuilder;
+
+        this.subAgent = subAgentPromptBuilder;
+
+        this.runtimeContext = runtimeContextBuilder;
+
+        this.projectContext = projectContextBuilder;
+
+        this.requests = requestBuilder;
+
+    }
+
+
+    mainMessages(task, { project } = {}) {
+
+        return this.main.build(task, { project });
+
+    }
+
+
+    subAgentMessages(
+        agentDefinition,
+        task,
+        context,
+        { project } = {}
+    ) {
+
+        return this.subAgent.build(
+            agentDefinition,
+            task,
+            context,
+            { project }
+        );
+
+    }
+
+
+    subAgentSystemPrompt(agentDefinition) {
+
+        return this.subAgent.buildSystemPrompt(agentDefinition);
+
+    }
+
+
+    runtimeContextMessage() {
+
+        return this.runtimeContext.build();
+
+    }
+
+
+    refreshRuntimeContext(messages) {
+
+        return this.runtimeContext.refresh(messages);
+
+    }
+
+
+    projectMessage(project) {
+
+        return this.projectContext.build(project);
+
+    }
+
+
+    request(args) {
+
+        return this.requests.build(args);
+
+    }
+
+}
+
+
+module.exports = PromptBuilder;
diff --git a/structured-ai/agent/prompt/PromptMessages.js b/structured-ai/agent/prompt/PromptMessages.js
new file mode 100644
index 0000000..526e3c0
--- /dev/null
+++ b/structured-ai/agent/prompt/PromptMessages.js
@@ -0,0 +1,44 @@
+/*
+|--------------------------------------------------------------------------
+| Prompt Messages
+|--------------------------------------------------------------------------
+|
+| The small shared pieces every prompt section message is built from:
+| JSON-typed system messages and the section-joined system text of the
+| sub-agent prompt. Pure helpers, no runtime knowledge.
+|--------------------------------------------------------------------------
+*/
+
+function jsonSystem(payload) {
+
+    return {
+        role: "system",
+
+        content:
+            JSON.stringify(payload)
+    };
+
+}
+
+
+/* A sub-agent's system text is its sections joined by blank lines, with
+   objects serialised and strings kept verbatim — the exact encoding the
+   historical buildAgentSystemPrompt used. */
+function joinSections(sections) {
+
+    return sections
+        .map(
+            item =>
+                typeof item === "string"
+                    ? item
+                    : JSON.stringify(item)
+        )
+        .join("\n\n");
+
+}
+
+
+module.exports = {
+    jsonSystem,
+    joinSections
+};
diff --git a/structured-ai/agent/prompt/RequestBuilder.js b/structured-ai/agent/prompt/RequestBuilder.js
new file mode 100644
index 0000000..578c5d6
--- /dev/null
+++ b/structured-ai/agent/prompt/RequestBuilder.js
@@ -0,0 +1,121 @@
+/*
+|--------------------------------------------------------------------------
+| Request Builder
+|--------------------------------------------------------------------------
+|
+| The OpenAI-compatible request body, moved out of agent.js
+| (EXECUTION_PLAN Phase 5, گام ۴): model, messages, temperature, tool
+| declarations, parallel_tool_calls, response_format — and the plain
+| completion variant (responseFormat null) the summariser gets, with no
+| tool schema and no parallel flag.
+|
+| The body is the historical buildAgentRequest() verbatim; the endpoint
+| profile and the response schema come in as injected closures so the
+| module still sees live settings and registry.
+|--------------------------------------------------------------------------
+*/
+
+const settings = require("../lib/storage");
+
+
+class RequestBuilder {
+
+    constructor({ endpointFor, RESPONSE_FORMAT_OF }) {
+
+        this.endpointFor = endpointFor;
+
+        this.RESPONSE_FORMAT_OF = RESPONSE_FORMAT_OF;
+
+    }
+
+
+    build({
+        messages,
+        agentDefinition,
+        tools,
+        responseFormat,
+        role,
+        withSchema = true
+    }) {
+
+        const profile =
+            this.endpointFor(role, agentDefinition);
+
+        if (responseFormat === null) {
+
+            /*
+            | A plain completion, used by the summariser.
+            */
+
+            const request = {
+                model:
+                    profile.model,
+
+                messages,
+
+                temperature:
+                    agentDefinition &&
+                    agentDefinition.temperature !== undefined
+                        ? agentDefinition.temperature
+                        : profile.temperature
+            };
+
+            if (
+                agentDefinition &&
+                agentDefinition.max_tokens
+            ) {
+                request.max_tokens = agentDefinition.max_tokens;
+            }
+
+            return request;
+        }
+
+        const request = {
+            model:
+                profile.model,
+
+            messages,
+
+            temperature:
+                profile.temperature,
+
+            tools,
+
+            parallel_tool_calls:
+                true
+        };
+
+        /*
+        | The schema is sent unless this endpoint has already refused
+        | it. Without it the model still has the contract in its
+        | instructions, and the parser accepts a native tool call either
+        | way.
+        */
+
+        if (withSchema) {
+
+            request.response_format =
+                this.RESPONSE_FORMAT_OF();
+        }
+
+        /*
+        | Left out by default, because a gateway that caps the answer
+        | for us is easier to see than a ceiling we set silently. When
+        | an answer is being cut off mid-write, this is the knob that
+        | fixes it.
+        */
+
+        const ceiling =
+            settings.get("MAX_RESPONSE_TOKENS");
+
+        if (ceiling > 0) {
+            request.max_tokens = ceiling;
+        }
+
+        return request;
+    }
+
+}
+
+
+module.exports = RequestBuilder;
diff --git a/structured-ai/agent/prompt/RuntimeContextBuilder.js b/structured-ai/agent/prompt/RuntimeContextBuilder.js
new file mode 100644
index 0000000..48f1218
--- /dev/null
+++ b/structured-ai/agent/prompt/RuntimeContextBuilder.js
@@ -0,0 +1,200 @@
+/*
+|--------------------------------------------------------------------------
+| Runtime Context Builder
+|--------------------------------------------------------------------------
+|
+| The dynamic runtime_context message: workspace, repository, plan,
+| memory, archive, policy, endpoints, budget and MCP state. Everything
+| volatile arrives through injected closures, so one instance serves
+| every run and every iteration, and the module itself imports nothing
+| from agent.js (EXECUTION_PLAN Phase 5, گام ۳).
+|
+| The built object reproduces the historical createRuntimeContext()
+| field for field; only the budget/root reads are re-routed through the
+| injected callbacks, which in modular mode answer for the calling run
+| and its project.
+|--------------------------------------------------------------------------
+*/
+
+const settings = require("../lib/storage");
+
+
+class RuntimeContextBuilder {
+
+    constructor(deps) {
+
+        this.deps = deps;
+
+    }
+
+
+    build() {
+
+        const deps = this.deps;
+
+        return {
+            ...deps.CONFIGURED_RUNTIME_OF(),
+
+            environment:
+                deps.detectEnvironment(),
+
+            repository:
+                deps.detectRepository(),
+
+            workspace: {
+                ...(deps.CONFIGURED_RUNTIME_OF().workspace || {}),
+
+                root:
+                    deps.workspaceRoot()
+            },
+
+            /*
+            | The group catalogue used to travel here as well: 2.7K
+            | characters describing tools whose full schemas are already
+            | in the request. Groups are how the policy reasons, not how
+            | the agent calls anything, so what the agent needs is the
+            | policy summary below, not the taxonomy behind it.
+            */
+
+            plan:
+                deps.planSummary(),
+
+            memory: {
+                enabled:
+                    settings.get("MEMORY_ENABLED") === true,
+
+                size_chars:
+                    deps.memorySizeChars(),
+
+                chunk_chars:
+                    settings.get("MEMORY_CHUNK_CHARS"),
+
+                max_summary_calls:
+                    settings.get("MEMORY_MAX_SUMMARY_CALLS"),
+
+                summary_parallelism:
+                    settings.get("MEMORY_SUMMARY_PARALLELISM")
+            },
+
+            /*
+            | The agent is told how much history is retrievable,
+            | otherwise it has no reason to search an archive it cannot
+            | see.
+            */
+
+            archive:
+                deps.archiveStats(),
+
+            policy:
+                deps.policySummary(),
+
+            endpoints:
+                deps.endpointOverview(),
+
+            runtime: {
+                workspace_root:
+                    deps.workspaceRoot(),
+
+                max_iterations:
+                    settings.get("MAX_ITERATIONS"),
+
+                max_agent_depth:
+                    settings.get("MAX_AGENT_DEPTH"),
+
+                max_parallel_tools:
+                    settings.get("MAX_PARALLEL_TOOLS"),
+
+                max_parallel_agents:
+                    settings.get("MAX_PARALLEL_AGENTS"),
+
+                max_total_agents:
+                    settings.get("MAX_TOTAL_AGENTS"),
+
+                agents_spawned:
+                    deps.agentsSpawned(),
+
+                agents_remaining:
+                    Math.max(
+                        0,
+                        settings.get("MAX_TOTAL_AGENTS") - deps.agentsSpawned()
+                    ),
+
+                iterations_per_agent:
+                    settings.get("MAX_ITERATIONS"),
+
+                max_run_ms:
+                    settings.get("MAX_RUN_MS"),
+
+                max_request_ms:
+                    settings.get("MAX_REQUEST_MS"),
+
+                max_context_chars:
+                    settings.get("MAX_CONTEXT_CHARS"),
+
+                run_remaining_ms:
+                    deps.runStartedAt()
+                        ? Math.max(0, deps.runRemainingMs())
+                        : settings.get("MAX_RUN_MS")
+            },
+
+            /*
+            | Which external servers this run can reach. Named rather
+            | than counted, because an agent that knows a "github"
+            | server exists asks it something; one told there are two
+            | servers does not.
+            */
+
+            mcp:
+                deps.mcpContext()
+        };
+
+    }
+
+
+    /* Rewrites the runtime_context system message of an in-flight
+       conversation in place, so every iteration sees fresh limits,
+       budget and MCP state. Returns whether a message was refreshed. */
+    refresh(messages) {
+
+        for (const message of messages) {
+
+            if (
+                message.role !== "system" ||
+                typeof message.content !== "string" ||
+                !message.content.startsWith("{")
+            ) {
+                continue;
+            }
+
+            let parsed;
+
+            try {
+
+                parsed = JSON.parse(message.content);
+
+            } catch {
+
+                continue;
+            }
+
+            if (parsed.type !== "runtime_context") {
+                continue;
+            }
+
+            message.content =
+                JSON.stringify({
+                    type: "runtime_context",
+
+                    context: this.build()
+                });
+
+            return true;
+        }
+
+        return false;
+    }
+
+}
+
+
+module.exports = RuntimeContextBuilder;
diff --git a/structured-ai/agent/prompt/SkillResolver.js b/structured-ai/agent/prompt/SkillResolver.js
new file mode 100644
index 0000000..f8d60b5
--- /dev/null
+++ b/structured-ai/agent/prompt/SkillResolver.js
@@ -0,0 +1,49 @@
+/*
+|--------------------------------------------------------------------------
+| Skill Resolver
+|--------------------------------------------------------------------------
+|
+| Which registry skills a profile may use, moved out of agent.js
+| (EXECUTION_PLAN Phase 5). Inactive skills — e.g. the semantic_engine
+| skill while the project's Semantic MCP is not ready — are filtered by
+| the injected isActiveSkill, which is the same gate the runtime has
+| always applied. Until Phase 6, "the project's Semantic MCP" is the
+| single Semantic Engine connection the process already has.
+|
+| The body is the historical resolveSkills() verbatim.
+|--------------------------------------------------------------------------
+*/
+
+function createSkillResolver({
+    SKILL_REGISTRY_OF,
+    isActiveSkill
+}) {
+
+    function resolve(skillNames) {
+
+        if (!Array.isArray(skillNames)) {
+            return [];
+        }
+
+        return skillNames
+            .map(
+                name =>
+                    SKILL_REGISTRY_OF().get(name)
+            )
+            .filter(
+                skill =>
+                    skill && isActiveSkill(skill)
+            );
+    }
+
+
+    return {
+        resolve
+    };
+
+}
+
+
+module.exports = {
+    createSkillResolver
+};
diff --git a/structured-ai/agent/prompt/SubAgentPromptBuilder.js b/structured-ai/agent/prompt/SubAgentPromptBuilder.js
new file mode 100644
index 0000000..d29cd17
--- /dev/null
+++ b/structured-ai/agent/prompt/SubAgentPromptBuilder.js
@@ -0,0 +1,202 @@
+/*
+|--------------------------------------------------------------------------
+| Sub-Agent Prompt Builder
+|--------------------------------------------------------------------------
+|
+| A specialist's opening messages, moved out of agent.js
+| (EXECUTION_PLAN Phase 5, گام ۲):
+|
+|   0. system text — persona, filtered execution rules, agent runtime
+|      rules, skills, output contract and delegation policy joined by
+|      blank lines (buildSystemPrompt)
+|   1. runtime_context (JSON)
+|   2. agent_profile (JSON)
+|   2a. project_context (JSON — additive, inherited from the parent run)
+|   3. available_tools (JSON — names only; schemas ride the request)
+|   4. task + parent context (user JSON)
+|
+|--------------------------------------------------------------------------
+*/
+
+const settings = require("../lib/storage");
+
+const { jsonSystem, joinSections } = require("./PromptMessages");
+
+
+class SubAgentPromptBuilder {
+
+    constructor(deps) {
+
+        this.deps = deps;
+
+    }
+
+
+    /* The historical buildAgentSystemPrompt, verbatim. */
+    buildSystemPrompt(agentDefinition) {
+
+        const capabilities =
+            this.deps.resolveAgentCapabilities(
+                agentDefinition
+            );
+
+        const personaText =
+            capabilities.persona?.system_prompt ||
+            "";
+
+        return joinSections([
+            personaText,
+
+            this.deps.executionRules(agentDefinition),
+
+            {
+                type: "agent_runtime_rules",
+
+                rules: [
+                    "You are an Agent inside a hierarchical Agent Runtime.",
+                    "You were given one task by a parent agent; complete that task and report back.",
+                    "Use only the tools provided by the runtime.",
+                    "Use only the skills assigned to your Agent Profile.",
+                    "Return your findings with the final action; the parent agent sees only that response.",
+                    "Never fabricate tool results.",
+                    "Never claim an operation succeeded unless runtime results confirm it."
+                ]
+            },
+
+            /*
+            | A specialist's own skills are its job, so they are in its
+            | prompt by default: two to five of them, and one skipped
+            | skill_get would cost it the expertise it was created for.
+            | SKILLS_INLINE_FOR_SUBAGENTS trades that for the index when
+            | the tokens matter more.
+            */
+
+            {
+                type: "skills",
+
+                note:
+                    settings.get("SKILLS_INLINE_FOR_SUBAGENTS") === true
+                        ? undefined
+                        : "Names only. Read one with skill_get before doing that kind of work.",
+
+                skills:
+                    settings.get("SKILLS_INLINE_FOR_SUBAGENTS") === true
+                        ? capabilities.skills
+                        : capabilities.skills.map(
+                            skill => ({
+                                name: skill.name,
+                                description: skill.description
+                            })
+                        )
+            },
+
+            {
+                type: "output_contract",
+
+                output_contract:
+                    agentDefinition.output_contract ||
+                    [
+                        "Report only results confirmed by runtime execution."
+                    ]
+            },
+
+            {
+                type: "delegation_policy",
+                delegation:
+                    agentDefinition.delegation ||
+                    {
+                        enabled: false,
+                        max_depth: 0,
+                        max_children: 0
+                    }
+            }
+        ]);
+    }
+
+
+    build(agentDefinition, task, context, { project } = {}) {
+
+        const systemPrompt =
+            this.buildSystemPrompt(
+                agentDefinition
+            );
+
+        const capabilities =
+            this.deps.resolveAgentCapabilities(
+                agentDefinition
+            );
+
+        const projectMessage =
+            this.deps.projectContextBuilder.build(project);
+
+        return [
+
+            {
+                role: "system",
+
+                content:
+                    systemPrompt
+            },
+
+            jsonSystem({
+                type:
+                    "runtime_context",
+
+                context:
+                    this.deps.runtimeContext()
+            }),
+
+            /*
+            | The profile used to travel whole: its persona, its skills,
+            | its output contract and its tool list, every one of which
+            | is already in the system prompt above or in the request's
+            | tools. What is left is what the agent cannot see anywhere
+            | else.
+            */
+
+            jsonSystem({
+                type:
+                    "agent_profile",
+
+                name:
+                    agentDefinition.name,
+
+                description:
+                    agentDefinition.description,
+
+                may_delegate:
+                    this.deps.mayDelegate(agentDefinition)
+            }),
+
+            projectMessage,
+
+            jsonSystem({
+                type:
+                    "available_tools",
+
+                note:
+                    "Full parameter schemas travel in the request's tools field.",
+
+                tools:
+                    capabilities.tools.map(
+                        tool => tool.function.name
+                    )
+            }),
+
+            {
+                role: "user",
+
+                content:
+                    JSON.stringify({
+                        task,
+                        context:
+                            context ?? null
+                    })
+            }
+        ].filter(Boolean);
+    }
+
+}
+
+
+module.exports = SubAgentPromptBuilder;
diff --git a/structured-ai/agent/prompt/ToolResolver.js b/structured-ai/agent/prompt/ToolResolver.js
new file mode 100644
index 0000000..5f0dc3f
--- /dev/null
+++ b/structured-ai/agent/prompt/ToolResolver.js
@@ -0,0 +1,75 @@
+/*
+|--------------------------------------------------------------------------
+| Tool Resolver
+|--------------------------------------------------------------------------
+|
+| Which tool declarations a profile may see, moved out of agent.js
+| (EXECUTION_PLAN Phase 5). The registry accessors are injected, so the
+| resolution tracks the live registry exactly like the function it
+| replaces, and this module knows nothing about the engine's globals.
+|
+| The body is the historical resolveTools() verbatim, including the
+| "*" grant and the MCP catalogue fallback.
+|--------------------------------------------------------------------------
+*/
+
+function createToolResolver({
+    TOOL_REGISTRY_OF,
+    mcpToolDeclarations
+}) {
+
+    function mcpRegistry() {
+
+        return new Map(
+            mcpToolDeclarations().map(
+                tool => [tool.function.name, tool]
+            )
+        );
+
+    }
+
+
+    function resolve(toolNames) {
+
+        /*
+        | "*" grants every registered tool. Used by the root orchestrator
+        | profile; sub-agent profiles should list tools explicitly.
+        */
+
+        if (toolNames === "*") {
+
+            return [
+                ...TOOL_REGISTRY_OF().values(),
+                ...mcpToolDeclarations()
+            ];
+
+        }
+
+        if (!Array.isArray(toolNames)) {
+            return [];
+        }
+
+        const fromMcp =
+            mcpRegistry();
+
+        return toolNames
+            .map(
+                name =>
+                    TOOL_REGISTRY_OF().get(name) ||
+                    fromMcp.get(name)
+            )
+            .filter(Boolean);
+    }
+
+
+    return {
+        resolve,
+        mcpRegistry
+    };
+
+}
+
+
+module.exports = {
+    createToolResolver
+};
