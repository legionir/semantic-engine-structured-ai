[
  {
    "type": "function",
    "function": {
      "name": "plan_get",
      "description": "Read the persistent real-work plan, assigned agents, next step, and the read-only runtime routine (before/after hooks).",
      "parameters": {
        "type": "object",
        "properties": {
          "summary_only": {
            "type": "boolean",
            "description": "Return only the progress summary instead of every phase."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_set",
      "description": "Create or replace the real-work plan. Steps may name an agent profile. Runtime hooks are shown separately as routine and must not be copied into phases.",
      "parameters": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "description": "What the whole plan achieves."
          },
          "phases": {
            "type": "array",
            "description": "Ordered phases. Each is an object with id, title, optional goal, and steps.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "goal": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Stable unique step id."
                      },
                      "title": {
                        "type": "string",
                        "description": "Concrete work item."
                      },
                      "agent": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Registered agent profile that owns this step, or null for the main agent."
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "in_progress",
                          "done",
                          "blocked",
                          "skipped"
                        ]
                      },
                      "evidence": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Runtime evidence for the current status."
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "agent"
                    ]
                  },
                  "description": "Real work steps only. Each may assign an agent profile; runtime hooks do not belong in the plan."
                }
              }
            }
          },
          "preserve_progress": {
            "type": "boolean",
            "description": "Keep the recorded status of steps that already exist. Defaults to true."
          }
        },
        "required": [
          "objective",
          "phases"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_update",
      "description": "Record progress: set the status of phases or steps, attach the evidence for a finished step, and add steps to a phase before starting it. A step cannot be marked done without evidence.",
      "parameters": {
        "type": "object",
        "properties": {
          "updates": {
            "type": "array",
            "description": "Status changes.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "done",
                    "blocked",
                    "skipped"
                  ]
                },
                "evidence": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "agent": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Change or clear the agent profile assigned to this step."
                }
              }
            }
          },
          "add_steps": {
            "type": "array",
            "description": "New steps for an existing phase.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "phase_id": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Stable unique step id."
                      },
                      "title": {
                        "type": "string",
                        "description": "Concrete work item."
                      },
                      "agent": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Registered agent profile that owns this step, or null for the main agent."
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "in_progress",
                          "done",
                          "blocked",
                          "skipped"
                        ]
                      },
                      "evidence": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Runtime evidence for the current status."
                      }
                    },
                    "required": [
                      "title"
                    ]
                  }
                }
              }
            }
          },
          "id": {
            "type": "string",
            "description": "Flat form: id of one phase or step to update."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done",
              "blocked",
              "skipped"
            ],
            "description": "Flat form: new status."
          },
          "evidence": {
            "type": "string",
            "description": "Flat form: evidence for the update."
          },
          "title": {
            "type": "string",
            "description": "Flat form: replacement title."
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Flat form: agent assignment for a step."
          },
          "phase_id": {
            "type": "string",
            "description": "Flat form: phase receiving new steps."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable unique step id."
                },
                "title": {
                  "type": "string",
                  "description": "Concrete work item."
                },
                "agent": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Registered agent profile that owns this step, or null for the main agent."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "done",
                    "blocked",
                    "skipped"
                  ]
                },
                "evidence": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Runtime evidence for the current status."
                }
              },
              "required": [
                "title"
              ]
            },
            "description": "Flat form: steps to add to phase_id."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  }
]
