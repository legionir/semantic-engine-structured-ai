{
  "type": "json_schema",
  "json_schema": {
    "name": "agent_action",
    "strict": false,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "Required top-level protocol version. Always return the literal string \"1.0\" as a sibling of action, never as an item inside tool_calls or delegations.",
          "enum": [
            "1.0"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "tool_call",
            "delegate",
            "final"
          ],
          "description": "Selects the field that is active in this response. Use tool_call only with at least one tool_calls item, delegate only with at least one delegations item, and final only with a non-null response containing the actual result. This is the operation being returned now, not a future intention."
        },
        "tool_calls": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Required non-empty id, unique within this action and used by depends_on references.",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "description": "Required exact name of one tool offered in this request.",
                    "minLength": 1
                  },
                  "arguments": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Required JSON object containing only parameters declared by the selected tool. Do not put result fields, prose, or another call envelope inside arguments. A dependent call may use ${call_id.result.path} references."
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required array of earlier call ids this call truly needs. Use [] for no dependencies; every named id must exist in the same action and cycles are invalid."
                  }
                },
                "required": [
                  "id",
                  "name",
                  "arguments",
                  "depends_on"
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "For action=tool_call this must be a non-empty array of calls to execute now. For action=delegate or final it must be null; never use an empty array."
        },
        "delegations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required non-empty id, unique within this delegation graph."
                  },
                  "agent": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Registered agent profile name, or null only when persona defines an ad-hoc agent."
                  },
                  "persona": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Registered persona name for an ad-hoc agent, or null when agent names a profile."
                  },
                  "skills": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Skill names for an ad-hoc agent; null when using a registered agent profile."
                  },
                  "tools": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Allowed tool names for an ad-hoc agent; null when using a registered agent profile."
                  },
                  "task": {
                    "type": "string",
                    "description": "Required self-contained task describing the result the child must produce.",
                    "minLength": 1
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required array of delegation ids that must finish first. Use [] when independent; every id must exist in this same delegation graph."
                  }
                },
                "required": [
                  "id",
                  "agent",
                  "persona",
                  "skills",
                  "tools",
                  "task",
                  "depends_on"
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "For action=delegate this must be a non-empty array of sub-agents to start now. For action=tool_call or final it must be null; never use an empty array."
        },
        "response": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "code",
                    "json",
                    "markdown"
                  ],
                  "description": "Rendering type for the final content."
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required non-empty final answer content, not a statement of a future operation."
                }
              },
              "required": [
                "type",
                "content"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "For action=final this must be a non-null object with the actual user-facing result. For tool_call or delegate it must be null. A plan to call a tool is not a final response."
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional structured result for action=final; null for tool_call and delegate."
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional failure details for action=final only; otherwise null. Set only when the objective actually failed."
        },
        "performed": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tools you actually used to reach this answer."
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Sub-agents whose reports you used."
                },
                "files_changed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Files you changed."
                }
              },
              "required": []
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional verified-work claim for action=final only; null for tool_call and delegate. List only operations confirmed by runtime results."
        }
      },
      "required": [
        "version",
        "action",
        "tool_calls",
        "delegations",
        "response",
        "data",
        "error"
      ],
      "description": "Exactly one complete agent action. The action selects one and only one active field: tool_call => non-empty tool_calls and delegations/response/data/error/performed null; delegate => non-empty delegations and tool_calls/response/data/error/performed null; final => response object and tool_calls/delegations null. Never describe a future operation in data or response; select tool_call or delegate so the runtime can execute it.",
      "allOf": [
        {
          "description": "Cross-field action invariant. Exactly one branch matches the selected action.",
          "anyOf": [
            {
              "properties": {
                "action": {
                  "const": "tool_call"
                },
                "tool_calls": {
                  "minItems": 1
                },
                "delegations": {
                  "type": "null"
                },
                "response": {
                  "type": "null"
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "null"
                },
                "performed": {
                  "type": "null"
                }
              },
              "required": [
                "action",
                "tool_calls",
                "delegations",
                "response",
                "data",
                "error"
              ]
            },
            {
              "properties": {
                "action": {
                  "const": "delegate"
                },
                "tool_calls": {
                  "type": "null"
                },
                "delegations": {
                  "minItems": 1
                },
                "response": {
                  "type": "null"
                },
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "null"
                },
                "performed": {
                  "type": "null"
                }
              },
              "required": [
                "action",
                "tool_calls",
                "delegations",
                "response",
                "data",
                "error"
              ]
            },
            {
              "properties": {
                "action": {
                  "const": "final"
                },
                "tool_calls": {
                  "type": "null"
                },
                "delegations": {
                  "type": "null"
                },
                "response": {
                  "type": "object"
                }
              },
              "required": [
                "action",
                "tool_calls",
                "delegations",
                "response",
                "data",
                "error"
              ]
            }
          ]
        }
      ]
    }
  }
}
