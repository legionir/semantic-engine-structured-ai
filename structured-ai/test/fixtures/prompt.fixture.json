{
  "description": "Prompt structure fixtures captured from the live builders (EXECUTION_PLAN, Phase 1). The contract is structural: role order, JSON payload types and required keys. Prose content may change intentionally; update the starts_with anchors only when that change is deliberate.",
  "main": {
    "builder": "createMainAgentMessages(task)",
    "message_count": 7,
    "structure": [
      { "index": 0, "role": "system", "kind": "text", "starts_with": "You are the Main AI Agent" },
      { "index": 1, "role": "system", "kind": "text", "starts_with": "EXECUTION RULES" },
      {
        "index": 2,
        "role": "system",
        "kind": "json",
        "json_type": "runtime_context",
        "context_keys": ["workspace", "environment", "repository", "execution", "limits", "security", "plan", "memory", "archive", "policy", "endpoints", "runtime", "mcp"]
      },
      { "index": 3, "role": "system", "kind": "json", "json_type": "available_skills" },
      { "index": 4, "role": "system", "kind": "json", "json_type": "available_personas" },
      { "index": 5, "role": "system", "kind": "json", "json_type": "available_agents" },
      { "index": 6, "role": "user", "kind": "text", "equals_task": true }
    ]
  },
  "sub_agent": {
    "builder": "createSubAgentMessages(agentDefinition, task, context)",
    "message_count": 5,
    "structure": [
      { "index": 0, "role": "system", "kind": "text", "contains": "EXECUTION RULES" },
      { "index": 1, "role": "system", "kind": "json", "json_type": "runtime_context" },
      { "index": 2, "role": "system", "kind": "json", "json_type": "agent_profile", "required_keys": ["type", "may_delegate"] },
      { "index": 3, "role": "system", "kind": "json", "json_type": "available_tools" },
      { "index": 4, "role": "user", "kind": "json", "required_keys": ["task"] }
    ],
    "profile_used": "code_analysis"
  },
  "request": {
    "source": "first POST body observed at the model endpoint during a baseline final-answer run",
    "top_level_keys": ["messages", "model", "parallel_tool_calls", "response_format", "temperature", "tools"],
    "values": {
      "temperature": 0.2,
      "parallel_tool_calls": true,
      "response_format.type": "json_schema",
      "response_format.json_schema.name": "agent_action",
      "response_format.json_schema.strict": false
    },
    "tools": {
      "shape": "array of { type, function: { name, description, parameters } }",
      "count_rule": "equals the number of tools resolved for the main agent from the current registry"
    }
  }
}
