{
  "name": "web-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Web-native 3D engine and visual editor - monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev:web": "npm run dev -w @webengine/web",
    "build:web": "npm run build -w @webengine/web",
    "typecheck:web": "npm run typecheck -w @webengine/web",
    "test:web": "vitest run apps/web",
    "dev:editor": "npm run dev -w @webengine/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
