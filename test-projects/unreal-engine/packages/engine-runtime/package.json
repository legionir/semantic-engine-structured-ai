{
  "name": "@web-engine/engine-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone runtime that runs engine scenes without the editor",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@web-engine/engine-core": "*",
    "@web-engine/engine-renderer": "*",
    "@web-engine/engine-assets": "*",
    "@web-engine/engine-input": "*",
    "@web-engine/engine-audio": "*"
  }
}
