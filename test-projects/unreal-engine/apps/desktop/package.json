{
  "name": "@webengine/desktop-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop wrapper for Web Engine",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main.js"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "@types/node": "^20.11.26",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.webengine.desktop",
    "productName": "Web Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    }
  }
}
